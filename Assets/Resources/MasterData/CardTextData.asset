      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u624B\u672D\u306E\u30B9\u30DA\u30EB\u30D6\u30FC\u30B9\u30C8\u3055\u308C\u305F\u56DE\u6570\u304C5\u56DE\u672A\u6E80\u306E\u30AB\u30FC\u30C9\u3059\u3079\u3066\u30925\u56DE\u30B9\u30DA\u30EB\u30D6\u30FC\u30B9\u30C8\u3055\u308C\u305F\u72B6\u614B\u306B\u3059\u308B\u3002"
