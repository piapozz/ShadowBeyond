      CardText: "\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306B3\u30C0\u30E1\u30FC\u30B8\u3002\u300E\u30DB\u30FC\u30EA\u30FC\u30D5\u30A1\u30EB\u30B3\u30F3\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002"
    - ID: 1605
