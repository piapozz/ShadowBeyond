      CardText: "\u3010\u5B88\u8B77\u3011\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u3053\u306E\u30D0\u30C8\u30EB\u4E2D\u306B\u7834\u58CA\u3055\u308C\u305F\u81EA\u5206\u306E\u5143\u306E\u30B3\u30B9\u30C8\u6700\u5927\u306E\u30A2\u30DF\u30E5\u30EC\u30C3\u30C8\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u3068\u540C\u540D\u306E\u30AB\u30FC\u30C91\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002"
    - ID: 1609
