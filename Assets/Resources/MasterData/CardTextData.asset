      CardText: "\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_9\u3011\u3053\u308C\u306F\u300C1\u30BF\u30FC\u30F3\u306B2\u56DE\u653B\u6483\u3067\u304D\u308B\u3002\u300D\u3092\u6301\u3064\u3002\u30BF\u30FC\u30F3\u7D42\u4E86\u307E\u3067\u3001\u3053\u308C\u306F\u300C\u53D7\u3051\u308B1\u4EE5\u4E0A\u30C0\u30E1\u30FC\u30B8\u30920\u306B\u3059\u308B\u3002\u300D\u3092\u6301\u3064\u3002\n\u3010\u75BE\u8D70\u3011"
    - ID: 103300
