      CardText: "\u3010\u30AA\u30FC\u30E9\u3011\n\u81EA\u5206\u304C\u30A2\u30DF\u30E5\u30EC\u30C3\u30C8\u3092\u3010\u30A2\u30AF\u30C8\u3011\u3057\u305F\u3068\u304D\u3001\u30BF\u30FC\u30F3\u7D42\u4E86\u307E\u3067\u3001\u3053\u308C\u306F+1/+0\u3059\u308B\u3002"
    - ID: 1601
