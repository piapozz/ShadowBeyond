      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u30EB\u30DF\u30CA\u30B9\u30CA\u30A4\u30C8\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\n\u3053\u308C\u304C\u5834\u306B\u3042\u308B\u9650\u308A\u3001\u81EA\u5206\u306E\u5834\u306E\u6307\u63EE\u5B98\u30FB\u30D5\u30A9\u30ED\u30EF\u30FC\u306F\u300CEP\u3092\u6D88\u8CBB\u305B\u305A\u9032\u5316\u3067\u304D\u308B\u3002\u300D\u3092\u6301\u3064\u3002"
