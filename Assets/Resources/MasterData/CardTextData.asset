      CardText: "\u3010\u878D\u5408\u3011\u300E\u30C7\u30B9\u30C8\u30ED\u30A4\u30A2\u30FC\u30C6\u30A3\u30D5\u30A1\u30AF\u30C8\u03B2\u300F\u3084\u300E\u30C7\u30B9\u30C8\u30ED\u30A4\u30A2\u30FC\u30C6\u30A3\u30D5\u30A1\u30AF\u30C8\u03B3\u300F\n\u3053\u308C\u306B\u3010\u878D\u5408\u3011\u3057\u305F\u3068\u304D\u3001\u3053\u308C\u306B\u3010\u878D\u5408\u3011\u3057\u305F\u7A2E\u985E\u304C2\u306A\u3089\u3001\u3053\u308C\u306F\u300E\u30A4\u30AF\u30B7\u30FC\u30C9\u30A2\u30FC\u30C6\u30A3\u30D5\u30A1\u30AF\u30C8\u03A9\u300F\u306B\u5909\u8EAB\u3059\u308B\u3002\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30923\u56DE\u5FA9\u3002"
