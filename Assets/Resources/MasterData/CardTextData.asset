  - name: TOG
    list:
    - ID: 104000
      Name: "\u30EF\u30A4\u30BA\u30DE\u30FC\u30DE\u30F3"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u5834\u306E\u30CB\u30E5\u30FC\u30C8\u30E9\u30EB\u30FB\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306F+1/+0\u3059\u308B\u3002"
    - ID: 104001
      Name: "\u30AA\u30A6\u30EB\u30AD\u30E3\u30C3\u30C8"
      CardText: "\u3010\u4EA4\u6226\u6642\u3011\u4EA4\u6226\u76F8\u624B\u304C\u653B\u6483\u529B1\u306A\u3089\u3001\u305D\u308C\u3092\u7834\u58CA\u3002"
    - ID: 104002
      Name: "\u30A2\u30C3\u30AF\u30B9\u30D5\u30A1\u30A4\u30BF\u30FC"
      CardText: "\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_6\u3011\u3053\u308C\u306F+3/+3\u3059\u308B\u3002"
    - ID: 104003
      Name: "\u529B\u6BD4\u3079"
      CardText: "\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_2\u3011\n\u3053\u308C\u304C\u5834\u306B\u3042\u308B\u9650\u308A\u3001\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306F\u3010\u5B88\u8B77\u3011\u3092\u6301\u3064\u3002"
    - ID: 104004
      Name: "\u5F77\u5FA8\u306E\u8A69\u4EBA\u30FB\u30A8\u30EB\u30BF"
      CardText: "\u3010\u9032\u5316\u6642\u3011\u3053\u308C\u304C\u5834\u3092\u96E2\u308C\u308B\u307E\u3067\u3001\u3059\u3079\u3066\u306E\u30EA\u30FC\u30C0\u30FC\u306F\u300C\u81EA\u5206\u306E\u30AB\u30FC\u30C9\u306E\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u306F\u50CD\u304B\u306A\u3044\u3002\u300D\u3092\u6301\u3064\u3002"
    - ID: 104005
      Name: "\u5747\u8861\u306E\u5927\u689F"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u306E\u30CB\u30E5\u30FC\u30C8\u30E9\u30EB\u30FB\u30AB\u30FC\u30C9\u304C20\u679A\u4EE5\u4E0A\u306A\u3089\u3001\u3053\u308C\u306F+2/+2\u3059\u308B\u3002"
    - ID: 104006
      Name: "\u30B4\u30D6\u30EA\u30F3\u30D7\u30EA\u30F3\u30BB\u30B9"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u30B4\u30D6\u30EA\u30F3\u300F2\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u300E\u30B4\u30D6\u30EA\u30F3\u30AD\u30F3\u30B0\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002"
    - ID: 104007
      Name: "\u51CD\u308A\u3065\u3051\u306E\u5DE8\u8C61"
      CardText: "\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u300E\u30A4\u30F3\u30DA\u30EA\u30A2\u30EB\u30DE\u30F3\u30E2\u30B9\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\n\u81EA\u5206\u304C\u5143\u306E\u30B3\u30B9\u30C87\u4EE5\u4E0A\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3092\u30D7\u30EC\u30A4\u3057\u305F\u3068\u304D\u3001\u3053\u308C\u3092\u7834\u58CA\u3002"
    - ID: 104008
      Name: "\u98A8\u306E\u8ECD\u795E\u30FB\u30B0\u30EA\u30FC\u30E0\u30CB\u30EB"
      CardText: "\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_10\u3011\u300C\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u3068\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u306B1\u30C0\u30E1\u30FC\u30B8\u3002\u300D\u30924\u56DE\u884C\u3046\u3002"
    - ID: 104009
      Name: "\u7652\u3057\u306E\u594F\u8005\u30FB\u30A2\u30F3\u30EA\u30A8\u30C3\u30C8"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u5834\u306E\u653B\u6483\u5F8C\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306F\u653B\u6483\u524D\u306B\u306A\u308A\u3001\u4F53\u529B\u3092\u4E0A\u9650\u307E\u3067\u56DE\u5FA9\u3002"
    - ID: 104010
      Name: "\u6FC0\u9707\u306E\u30AA\u30FC\u30AC"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u304B\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u3092\u9078\u3076\u3002\u305D\u308C\u306B3\u30C0\u30E1\u30FC\u30B8\u3002\n\u3010\u9032\u5316\u6642\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u304B\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u3092\u9078\u3076\u3002\u305D\u308C\u306B3\u30C0\u30E1\u30FC\u30B8\u3002"
