      Name: "\u30DE\u30B9\u30BF\u30FC\u30EC\u30C7\u30A3\u30BB\u30FC\u30B8"
      CardText: "\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u81EA\u5206\u306E\u5834\u306E\u30A2\u30DF\u30E5\u30EC\u30C3\u30C8\u3059\u3079\u3066\u306F\u30AB\u30A6\u30F3\u30C8\u3092-1\u3059\u308B\u3002"
    - ID: 103702
      Name: "\u719F\u9054\u306E\u8ABF\u6559\u5E2B"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u8A60\u5531\uFF1A\u8056\u7363\u3078\u306E\u8A93\u3044\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002"
    - ID: 103703
      Name: "\u30BD\u30A6\u30EB\u30B3\u30EC\u30AF\u30BF\u30FC"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u8A60\u5531\uFF1A\u6B7B\u306E\u5BA3\u544A\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002"
    - ID: 103704
      Name: "\u4FE1\u4EF0\u306E\u5177\u73FE\u5316"
      CardText: "\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u306E\u30B3\u30B9\u30C82\u4EE5\u4E0B\u306E\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3\u3011\u3092\u6301\u3064\u30A2\u30DF\u30E5\u30EC\u30C3\u30C8\u304B\u3089\u305D\u308C\u305E\u308C\u540D\u524D\u306E\u7570\u306A\u308B\u30E9\u30F3\u30C0\u30E03\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002"
    - ID: 103705
      Name: "\u714C\u7FFC\u306E\u6226\u58EB\u30FB\u30EA\u30CE"
      CardText: "\u3010\u4EA4\u6226\u6642\u3011\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u306B1\u30C0\u30E1\u30FC\u30B8\u3002\n\u3010\u9032\u5316\u6642\u3011\u3010\u4EA4\u6226\u6642\u3011\u3068\u540C\u3058\u80FD\u529B\u304C\u50CD\u304F\u3002"
    - ID: 103706
      Name: "\u90AA\u60AA\u306A\u308B\u4E88\u8A00\u8005\u30FB\u30C0\u30E0\u30B9"
      CardText: "\u76F8\u624B\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u653B\u6483\u3057\u305F\u3068\u304D\u3001\u305D\u308C\u306F\u300C\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u3053\u308C\u3092\u7834\u58CA\u3002\u300D\u3092\u6301\u3064\u3002"
    - ID: 103707
      Name: "\u30A8\u30F3\u30B7\u30A7\u30F3\u30C8\u30EC\u30AA\u30B9\u30D4\u30EA\u30C3\u30C8"
      CardText: "\u3010\u9032\u5316\u6642\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306B2\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 103708
      Name: "\u30DA\u30AC\u30B5\u30B9\u306E\u7D50\u6676\u50CF"
      CardText: "\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_4\u3011\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u81EA\u5206\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u3068\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30921\u56DE\u5FA9\u3002"
    - ID: 103709
      Name: "\u30F4\u30A1\u30EB\u30CF\u30E9\u30B8\u30A7\u30CD\u30E9\u30EB"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u5834\u306E\u4ED6\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306F+3/+3\u3057\u3066\u3010\u7A81\u9032\u3011\u3092\u6301\u3064\u3002"
    - ID: 103710
      Name: "\u714C\u89D2\u306E\u6226\u58EB\u30FB\u30B5\u30EA\u30C3\u30B5"
      CardText: "\u3010\u7A81\u9032\u3011\n\u53D7\u3051\u308B4\u4EE5\u4E0A\u306E\u30C0\u30E1\u30FC\u30B8\u30923\u306B\u3059\u308B\u3002"
    - ID: 103711
      Name: "\u795E\u9B54\u88C1\u5224\u6240"
      CardText: "\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_3\u3011\n\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u3092\u7834\u58CA\u3002\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3068\u540C\u3058\u80FD\u529B\u304C\u50CD\u304F\u3002"
