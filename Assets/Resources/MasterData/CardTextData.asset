      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3053\u308C\u304C\u5834\u3092\u96E2\u308C\u308B\u307E\u3067\u3001\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u306F\u300C\u53D7\u3051\u308B1\u4EE5\u4E0A\u306E\u30C0\u30E1\u30FC\u30B8\u30920\u306B\u3059\u308B\u3002\u300D\u3092\u6301\u3064\u3002"
