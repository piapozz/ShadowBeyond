      CardText: "\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_2\u3011\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u300E\u30DB\u30FC\u30EA\u30FC\u30D5\u30EC\u30A4\u30E0\u30BF\u30A4\u30AC\u30FC\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\n\u30B3\u30B9\u30C81\u3010\u30A2\u30AF\u30C8\u3011\u3053\u308C\u306E\u30AB\u30A6\u30F3\u30C8\u3092-1\u3059\u308B\u3002"
