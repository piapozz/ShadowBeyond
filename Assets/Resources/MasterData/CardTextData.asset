    - ID: 3108
      Name: "\u4E0D\u6BBA\u306E\u7D99\u627F\u8005\u30FB\u30AF\u30EB\u30EB"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306F-0/-2\u3059\u308B\u3002\n\u3010\u6F5C\u4F0F\u3011\n\u76F8\u624B\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u306E\u4F53\u529B\u304C\u5834\u3067-\u3055\u308C\u305F\u3068\u304D\u3001\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u3054\u3068\u306B1\u56DE\u3001\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30921\u56DE\u5FA9\u3002\n\u3010\u8D85\u9032\u5316\u6642\u3011\u76F8\u624B\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u4E0D\u6BBA\u306E\u7D99\u627F\u8005\u30FB\u30AF\u30EB\u30EB\u300F\u3092\u6301\u3064\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_2\u3011\n\u81EA\u5206\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u5834\u306B\u51FA\u305F\u3068\u304D\u3001\u305D\u308C\u306F-1/-1\u3059\u308B\u3002"
    - ID: 3109
