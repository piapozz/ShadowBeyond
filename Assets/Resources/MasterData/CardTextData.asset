      CardText: "\u81EA\u5206\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u4ED6\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306BX\u30C0\u30E1\u30FC\u30B8\u3002X\u306F\u9078\u3093\u3060\u30D5\u30A9\u30ED\u30EF\u30FC\u306E\u653B\u6483\u529B\u3067\u3042\u308B\u3002"
