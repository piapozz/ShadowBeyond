    - ID: 2107
      Name: "\u82B1\u5712\u306E\u5C0E\u304D"
      CardText: "\u3010\u878D\u5408\u3011\u30A8\u30EB\u30D5\u30FB\u30AB\u30FC\u30C9\n\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30891\u679A\u3092\u5F15\u304F\u3002\u3053\u308C\u306B\u3010\u878D\u5408\u3011\u3057\u3066\u3044\u305F\u306A\u3089\u30011\u679A\u3067\u306F\u306A\u304F2\u679A\u3002"
    - ID: 2108
      Name: "\u7FC5\u306E\u5973\u738B\u30FB\u30C6\u30A3\u30BF\u30FC\u30CB\u30A2"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u30D5\u30A7\u30A2\u30EA\u30FC\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u7FC5\u306E\u5973\u738B\u30FB\u30C6\u30A3\u30BF\u30FC\u30CB\u30A2\u300F\u3092\u6301\u3064\u3002\n\u3010\u9032\u5316\u6642\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306F\u300E\u30D5\u30A7\u30A2\u30EA\u30FC\u300F\u306B\u5909\u8EAB\u3059\u308B\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u958B\u59CB\u6642\u3001\u300E\u30D5\u30A7\u30A2\u30EA\u30FC\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002"
    - ID: 2109
      Name: "\u7D61\u307F\u4ED8\u304F\u5BC6\u6797\u30FB\u30EA\u30DE\u30FC\u30AC"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC2\u679A\u3092\u9078\u3076\u3002\u76F8\u624B\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u307E\u3067\u3001\u305D\u308C\u306F\u300C\u30D5\u30A9\u30ED\u30EF\u30FC\u3084\u30EA\u30FC\u30C0\u30FC\u3092\u653B\u6483\u3067\u304D\u306A\u3044\u3002\u300D\u3092\u6301\u3064\u3002\n\u3010\u8D85\u9032\u5316\u6642\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC2\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306F\u300C\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u306B1\u30C0\u30E1\u30FC\u30B8\u3002\u3053\u308C\u306B2\u30C0\u30E1\u30FC\u30B8\u3002\u300D\u3092\u6301\u3064\u3002"
    - ID: 2200
      Name: "\u30C8\u30EA\u30AC\u30FC\u30E1\u30A4\u30C9\u30FB\u30BB\u30EA\u30A8"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E02\u679A\u306B1\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 2201
      Name: "\u6697\u95D8\u306E\u30CB\u30F3\u30B8\u30E3\u30DE\u30B9\u30BF\u30FC"
      CardText: "\u3010\u6F5C\u4F0F\u3011"
    - ID: 2202
      Name: "\u5546\u8AC7\u6210\u7ACB"
      CardText: "\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30892\u679A\u3092\u5F15\u304F\u3002\u76F8\u624B\u306F\u81EA\u8EAB\u306E\u30C7\u30C3\u30AD\u304B\u30891\u679A\u3092\u5F15\u304F\u3002"
    - ID: 2203
      Name: "\u8C6A\u80C6\u306A\u308B\u526F\u56E3\u9577\u30FB\u30B2\u30EB\u30C8"
      CardText: "\u3010\u5B88\u8B77\u3011\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u81EA\u5206\u306E\u5834\u306B\u8D85\u9032\u5316\u5F8C\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u3042\u308B\u306A\u3089\u3001\u81EA\u5206\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306F+1/+1\u3059\u308B\u3002"
    - ID: 2204
      Name: "\u30AA\u30FC\u30C7\u30A3\u30CA\u30EA\u30FC\u30CA\u30A4\u30C8\u30FB\u30E9\u30AD\u30EB"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u3089\u30B9\u30DA\u30EB1\u679A\u3092\u5F15\u304F\u3002\n\u3010\u9032\u5316\u6642\u3011\u81EA\u5206\u306EPP\u30922\u56DE\u5FA9\u3002"
    - ID: 2205
      Name: "\u4E09\u5C06\u59EB\u306E\u4E71\u6483"
      CardText: "\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306B4\u30C0\u30E1\u30FC\u30B8\u3002\n\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_4\u30111\u679A\u3067\u306F\u306A\u304F3\u679A\u3002"
    - ID: 2206
      Name: "\u4F11\u65E5\u306E\u738B\u5973\u30FB\u30D7\u30EA\u30E0"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u9759\u304B\u306A\u308B\u30E1\u30A4\u30C9\u30FB\u30CE\u30FC\u30CB\u30E3\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002\n\u3010\u6F5C\u4F0F\u3011\n\u3010\u8D85\u9032\u5316\u6642\u3011\u81EA\u5206\u306E\u5834\u306E\u4ED6\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306F+1/+1\u3059\u308B\u3002"
    - ID: 2207
      Name: "\u30BD\u30FC\u30C9\u30D7\u30EA\u30F3\u30BB\u30B9\u30FB\u30ED\u30BC"
      CardText: "\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_5\u3011\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u3089\u30B3\u30B9\u30C82\u4EE5\u4E0B\u306E\u30ED\u30A4\u30E4\u30EB\u30FB\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u5F15\u304F\u3002\u305D\u308C\u306E\u30B3\u30B9\u30C8\u30920\u306B\u3059\u308B\u3002\n\u3010\u7A81\u9032\u3011\n\u3010\u653B\u6483\u6642\u3011\u30C0\u30E1\u30FC\u30B8\u3092\u53D7\u3051\u3066\u3044\u308B\u30D5\u30A9\u30ED\u30EF\u30FC\u3078\u306E\u653B\u6483\u306A\u3089\u3001\u4EA4\u6226\u76F8\u624B\u3092\u7834\u58CA\u3002"
    - ID: 2208
      Name: "\u9759\u5BC2\u306E\u30A2\u30CA\u30C6\u30DE\u30FB\u30AE\u30EB\u30C0\u30EA\u30A2"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u9023\u643A_20\u3011\u3053\u308C\u306F\u8D85\u9032\u5316\u3059\u308B\u3002\n\u81EA\u5206\u306E\u4ED6\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u5834\u306B\u51FA\u305F\u3068\u304D\u3001\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306B1\u30C0\u30E1\u30FC\u30B8\u3002\n\u3053\u308C\u304C\u9032\u5316\u3057\u305F\u3068\u304D\u3001\u300E\u30B9\u30C6\u30A3\u30FC\u30EB\u30CA\u30A4\u30C8\u300F2\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\u305D\u308C\u306F\u3010\u7A81\u9032\u3011\u3092\u6301\u3064\u3002"
    - ID: 2209
      Name: "\u30EC\u30F4\u30A3\u30AA\u30F3\u306E\u8D85\u8D8A\u8005\u30FB\u30E6\u30EA\u30A6\u30B9"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u30CA\u30A4\u30C8\u300F2\u679A\u3092\u76F8\u624B\u306E\u5834\u306B\u51FA\u3059\u3002\n\u76F8\u624B\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u5834\u306B\u51FA\u305F\u3068\u304D\u3001\u76F8\u624B\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u307E\u3067\u3001\u305D\u308C\u306F\u300C\u30D5\u30A9\u30ED\u30EF\u30FC\u3084\u30EA\u30FC\u30C0\u30FC\u3092\u653B\u6483\u3067\u304D\u306A\u3044\u3002\u300D\u3092\u6301\u3064\u3002\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u306B1\u30C0\u30E1\u30FC\u30B8\u3002\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30921\u56DE\u5FA9\u3002"
    - ID: 2210
      Name: "\u9759\u304B\u306A\u308B\u30E1\u30A4\u30C9\u30FB\u30CE\u30FC\u30CB\u30E3"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u5834\u306B\u300E\u4F11\u65E5\u306E\u738B\u5973\u30FB\u30D7\u30EA\u30E0\u300F\u304C\u3042\u308B\u306A\u3089\u3001\u3053\u308C\u306F+1/+1\u3057\u3066\u3010\u5FC5\u6BBA\u3011\u3092\u6301\u3064\u3002\n\u3010\u5B88\u8B77\u3011"
    - ID: 2300
      Name: "\u61A7\u61AC\u306E\u9B54\u5973\u30FB\u30E1\u30EB\u30F4\u30A3"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u9B54\u5973\u306E\u932C\u91D1\u91DC\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002\u81EA\u5206\u306E\u5834\u306B\u8D85\u9032\u5316\u5F8C\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u3042\u308B\u306A\u3089\u3001\u81EA\u5206\u306E\u5834\u306E\u571F\u306E\u5370\u3092+2\u3059\u308B\u3002"
    - ID: 2301
      Name: "\u9B54\u5C0E\u306E\u53F8\u66F8"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u624B\u672D1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u3092\u30C7\u30C3\u30AD\u306B\u623B\u3059\u3002\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u3089\u30B9\u30DA\u30EB1\u679A\u3092\u5F15\u304F\u3002"
    - ID: 2302
      Name: "\u30A2\u30A4\u30B9\u30D4\u30A2\u30FC\u30B9"
      CardText: "\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u3092\u7834\u58CA\u3002\u3010\u571F\u306E\u79D8\u8853_1\u3011\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u306B2\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 2303
      Name: "\u8ABF\u9999\u306E\u9B54\u8853\u5E2B"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306B3\u30C0\u30E1\u30FC\u30B8\u3002\u81EA\u5206\u306E\u5834\u306E\u571F\u306E\u5370\u3092+1\u3059\u308B\u3002\n\u3010\u9032\u5316\u6642\u3011\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3068\u540C\u3058\u80FD\u529B\u304C\u50CD\u304F\u3002"
    - ID: 2304
      Name: "\u5426\u5B9A\u306E\u8A60\u5531\u30FB\u30D0\u30FC\u30BC\u30F3\u30C8"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u30AA\u30CB\u30AA\u30F3\u8ECD\u56E3\u300F2\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\n\u3010\u9032\u5316\u6642\u3011\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u5426\u5B9A\u306E\u8A60\u5531\u30FB\u30D0\u30FC\u30BC\u30F3\u30C8\u300F\u3092\u6301\u3064\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u958B\u59CB\u6642\u3001\u300E\u30AA\u30CB\u30AA\u30F3\u8ECD\u56E3\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002"
    - ID: 2305
      Name: "\u30AB\u30AA\u30B9\u30D5\u30EC\u30A4\u30E0"
      CardText: "X\u306F0\u304B\u3089\u59CB\u307E\u308B\u3002\n\u3010\u30B9\u30DA\u30EB\u30D6\u30FC\u30B9\u30C8\u6642\u3011\u3053\u308C\u306EX\u3092+1\u3059\u308B\u3002\n\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306BX\u30C0\u30E1\u30FC\u30B8\u3092\u5272\u308A\u3075\u308B\u3002"
    - ID: 2306
      Name: "\u30DE\u30CA\u30EA\u30A2\u306E\u5263\u58EB\u30FB\u30AA\u30FC\u30A6\u30A7\u30F3"
      CardText: "\u3010\u5B88\u8B77\u3011\n\u3010\u4EA4\u6226\u6642\u3011\u81EA\u5206\u306E\u624B\u672D\u3059\u3079\u3066\u306F1\u56DE\u30B9\u30DA\u30EB\u30D6\u30FC\u30B9\u30C8\u3059\u308B\u3002\n\u3010\u9032\u5316\u6642\u3011\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u3089\u30D5\u30A9\u30ED\u30EF\u30FC2\u679A\u3092\u5F15\u304F\u3002"
    - ID: 2307
      Name: "\u30D1\u30E1\u30E9\u306E\u821E\u8E0F"
      CardText: "\u81EA\u5206\u306E\u5834\u306E\u571F\u306E\u5370\u3092+1\u3059\u308B\u3002\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u30D1\u30E1\u30E9\u306E\u821E\u8E0F\u300F\u3092\u6301\u3064\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_1\u3011\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30891\u679A\u3092\u5F15\u304F\u3002\u3010\u571F\u306E\u79D8\u8853_10\u3011\u81EA\u5206\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306F\u653B\u6483\u529B/\u4F53\u529B\u304C2\u500D\u306B\u306A\u308B\u3002"
    - ID: 2308
      Name: "\u30A2\u30C0\u30DE\u30F3\u30C8\u30A2\u30EB\u30B1\u30DF\u30B9\u30C8\u30FB\u30CE\u30FC\u30DE\u30F3"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u571F\u306E\u79D8\u8853_1\u3011\u3010\u30E2\u30FC\u30C9\u30111\u3064\u3092\u9078\u3093\u3067\u305D\u306E\u80FD\u529B\u304C\u50CD\u304F\u3002\n\uFF081\uFF09\u300E\u30AC\u30FC\u30C7\u30A3\u30A2\u30F3\u30B4\u30FC\u30EC\u30E0\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\u305D\u308C\u306F\u3010\u30D0\u30EA\u30A2\u3011\u3092\u6301\u3064\u3002\n\uFF082\uFF09\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30893\u679A\u3092\u5F15\u304F\u3002\n\uFF083\uFF09\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30924\u56DE\u5FA9\u3002\n\u3010\u9032\u5316\u6642\u3011\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3068\u540C\u3058\u80FD\u529B\u304C\u50CD\u304F\u3002"
    - ID: 2309
      Name: "\u66B4\u98DF\u306E\u30A2\u30CA\u30C6\u30DE\u30FB\u30E9\u30E9\u30A2\u30F3\u30BB\u30E0"
      CardText: "\u3010\u30AA\u30FC\u30E9\u3011\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u3010\u571F\u306E\u79D8\u8853_2\u3011\u300E\u66B4\u98DF\u306E\u30A2\u30CA\u30C6\u30DE\u30FB\u30E9\u30E9\u30A2\u30F3\u30BB\u30E0\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\n\u3010\u8D85\u9032\u5316\u6642\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC2\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u3092\u7834\u58CA\u3002"
