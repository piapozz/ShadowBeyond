      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306B2\u30C0\u30E1\u30FC\u30B8\u3002\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30922\u56DE\u5FA9\u3002"
    - ID: 105308
      Name: "\u30EB\u30CA\u30EB\u306E\u9B54\u8853\u5E2B\u30FB\u30D7\u30EA\u30B9"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306BX\u30C0\u30E1\u30FC\u30B8\u3002X\u306F\u81EA\u5206\u306E\u624B\u672D\u306E\u30CB\u30E5\u30FC\u30C8\u30E9\u30EB\u30FB\u30AB\u30FC\u30C9\u306E\u679A\u6570\u3067\u3042\u308B\u3002\n\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_7\u3011\u3053\u308C\u306F\u9032\u5316\u3059\u308B\u3002\n\u3053\u308C\u304C\u9032\u5316\u5F8C\u306A\u3089\u3010\u75BE\u8D70\u3011"
