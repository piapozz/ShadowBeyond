    - ID: 3408
      Name: "\u70C8\u7D76\u306E\u9855\u73FE\u30FB\u30AC\u30EB\u30DF\u30FC\u30E6"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u70C8\u7D76\u306E\u9855\u73FE\u30FB\u30AC\u30EB\u30DF\u30FC\u30E6\u300F\u3092\u6301\u3064\u3002\n\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_7\u3011\u3053\u308C\u306F\u3010\u75BE\u8D70\u3011\u3092\u6301\u3064\u3002\n\u3053\u308C\u304C\u30C0\u30E1\u30FC\u30B8\u3092\u53D7\u3051\u3066\u7834\u58CA\u3055\u308C\u306A\u304B\u3063\u305F\u3068\u304D\u3001\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u3054\u3068\u306B1\u56DE\u3001\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306B3\u30C0\u30E1\u30FC\u30B8\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u81EA\u5206\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u30C0\u30E1\u30FC\u30B8\u3092\u53D7\u3051\u3066\u7834\u58CA\u3055\u308C\u306A\u304B\u3063\u305F\u3068\u304D\u3001\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u3054\u3068\u306B1\u56DE\u3001\u300E\u70C8\u7D76\u306E\u6EC5\u7259\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002"
    - ID: 3409
      Name: "\u4FAE\u8511\u306E\u7D99\u627F\u8005\u30FB\u30A2\u30B8\u30E5\u30E9\u30D5\u30EA\u30FC\u30C8"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300C\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306B2\u30C0\u30E1\u30FC\u30B8\u3002\u300D\u30923\u56DE\u884C\u3046\u3002\n\u3010\u5B88\u8B77\u3011\n\u3053\u308C\u304C\u30C0\u30E1\u30FC\u30B8\u3092\u53D7\u3051\u3066\u7834\u58CA\u3055\u308C\u306A\u304B\u3063\u305F\u3068\u304D\u3001\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u306A\u3089\u3001\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u306B1\u30C0\u30E1\u30FC\u30B8\u3002\n\u3010\u8D85\u9032\u5316\u6642\u3011\u3053\u308C\u3092\u4E0A\u9650\u307E\u3067\u56DE\u5FA9\u3002\u300C\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306B2\u30C0\u30E1\u30FC\u30B8\u3002\u300D\u30923\u56DE\u884C\u3046\u3002"
    - ID: 3410
      Name: "\u70C8\u7D76\u306E\u6EC5\u7259"
      CardText: "\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306B1\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 3500
      Name: "\u6DF7\u878D\u306E\u80AF\u5B9A\u8005"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u30E2\u30FC\u30C9\u30111\u3064\u3092\u9078\u3093\u3067\u305D\u306E\u80FD\u529B\u304C\u50CD\u304F\u3002\n\uFF081\uFF09\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306B1\u30C0\u30E1\u30FC\u30B8\u3002\n\uFF082\uFF09\u3053\u308C\u306F+2/+2\u3059\u308B\u3002\n\u3010\u9032\u5316\u6642\u3011\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3068\u540C\u3058\u80FD\u529B\u304C\u50CD\u304F\u3002"
    - ID: 3501
      Name: "\u6CE1\u6CAB\u306E\u9B3C\u59EB"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC2\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u3092\u7834\u58CA\u3002\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u306B4\u30C0\u30E1\u30FC\u30B8\u3002\n\u3010\u75BE\u8D70\u3011"
    - ID: 3502
      Name: "\u66B4\u8650\u306E\u884C\u9032"
      CardText: "\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E02\u679A\u3068\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u306B2\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 3503
      Name: "\u30D5\u30EC\u30C3\u30B7\u30E5\u30B0\u30EC\u30A4\u30D6\u30AD\u30FC\u30D1\u30FC"
      CardText: "\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_7\u3011\u3010\u30EA\u30A2\u30CB\u30E1\u30A4\u30C8_5\u3011\u3068\u3010\u30EA\u30A2\u30CB\u30E1\u30A4\u30C8_3\u3011\u3092\u884C\u3046\u3002"
    - ID: 3504
      Name: "\u6DF7\u878D\u306E\u7948\u7977\u8005"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u30E2\u30FC\u30C9\u30111\u3064\u3092\u9078\u3093\u3067\u305D\u306E\u80FD\u529B\u304C\u50CD\u304F\u3002\n\uFF081\uFF09\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306B3\u30C0\u30E1\u30FC\u30B8\u3002\n\uFF082\uFF09\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30922\u56DE\u5FA9\u3002\n\u3010\u9032\u5316\u6642\u3011\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3068\u540C\u3058\u80FD\u529B\u304C\u50CD\u304F\u3002"
    - ID: 3505
      Name: "\u6DF7\u878D\u306E\u57CE"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u30E2\u30FC\u30C9\u30111\u3064\u3092\u9078\u3093\u3067\u305D\u306E\u80FD\u529B\u304C\u50CD\u304F\u3002\n\uFF081\uFF09\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30891\u679A\u3092\u5F15\u304F\u3002\n\uFF082\uFF09\u81EA\u5206\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306F+1/+1\u3059\u308B\u3002\n\u30B3\u30B9\u30C81\u3010\u30A2\u30AF\u30C8\u3011\u3053\u308C\u3092\u7834\u58CA\u3002\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3068\u540C\u3058\u80FD\u529B\u304C\u50CD\u304F\u3002"
    - ID: 3506
      Name: "\u6DF7\u878D\u306E\u56E3\u7D50\u8005"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u30E2\u30FC\u30C9\u30111\u3064\u3092\u9078\u3093\u3067\u305D\u306E\u80FD\u529B\u304C\u50CD\u304F\u3002\n\uFF081\uFF09\u300E\u6DF7\u878D\u306E\u56E3\u7D50\u8005\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\u305D\u308C\u3068\u3053\u308C\u306F\u3010\u7A81\u9032\u3011\u3092\u6301\u3064\u3002\n\uFF082\uFF09\u300E\u6DF7\u878D\u306E\u56E3\u7D50\u8005\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\u305D\u308C\u3068\u3053\u308C\u306F\u3010\u5B88\u8B77\u3011\u3092\u6301\u3064\u3002\n\uFF083\uFF09\u81EA\u5206\u306E\u5834\u306E\u300E\u6DF7\u878D\u306E\u56E3\u7D50\u8005\u300F\u3059\u3079\u3066\u306F+2/+2\u3059\u308B\u3002\n\u3010\u8D85\u9032\u5316\u6642\u3011\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3068\u540C\u3058\u80FD\u529B\u304C\u50CD\u304F\u3002"
    - ID: 3507
      Name: "\u53EB\u559A\u3068\u618E\u60AA"
      CardText: "\u3010\u30E2\u30FC\u30C9\u30112\u3064\u3092\u9078\u3093\u3067\u305D\u306E\u80FD\u529B\u304C\u50CD\u304F\u3002\n\uFF081\uFF09\u81EA\u5206\u306EPP\u30921\u56DE\u5FA9\u3002\n\uFF082\uFF09\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u3089\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u5F15\u304F\u3002\n\uFF083\uFF09\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u3089\u30B3\u30B9\u30C83\u306E\u30B9\u30DA\u30EB1\u679A\u3092\u5F15\u304F\u3002\n\uFF084\uFF09\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306B4\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 3508
      Name: "\u6DF7\u878D\u306E\u7D99\u627F\u8005\u30FB\u30B7\u30E3\u30E0\uFF1D\u30CA\u30AF\u30A2"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u4FE1\u4EF0\u5024\u3092-10\u3057\u3066\u3001\u81EA\u5206\u306E\u4FE1\u4EF0\u306F\u300C\u81EA\u5206\u304C\u9078\u3076\u3010\u30E2\u30FC\u30C9\u3011\u306E\u6570\u3092+1\u3059\u308B\u3002\u300D\u3092\u6301\u3064\u3002\n\u3010\u8D85\u9032\u5316\u6642\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u3092\u7834\u58CA\u3057\u3066\u3001\u540C\u540D\u306E\u30AB\u30FC\u30C91\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002\n\u4FE1\u4EF0\n\u4FE1\u4EF0\u5024\u306F0\u304B\u3089\u59CB\u307E\u308B\u3002\n\u81EA\u5206\u304C\u3010\u30E2\u30FC\u30C9\u3011\u3092\u9078\u3093\u3060\u3068\u304D\u3001\u4FE1\u4EF0\u5024\u3092+1\u3059\u308B\u3002"
    - ID: 3509
      Name: "\u7D76\u53EB\u3068\u611B\u7D76\u306E\u9855\u73FE\u30FB\u30EB\u30EB\u30CA\u30A4\uFF06\u30F4\u30A1\u30FC\u30CA\u30EC\u30AF"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u30E2\u30FC\u30C9\u30111\u3064\u3092\u9078\u3093\u3067\u305D\u306E\u80FD\u529B\u304C\u50CD\u304F\u3002\n\uFF081\uFF09\u300E\u7D76\u53EB\u306E\u62E1\u6563\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002\n\uFF082\uFF09\u300E\u611B\u7D76\u306E\u98DB\u7FD4\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002"
    - ID: 3510
      Name: "\u7D76\u53EB\u306E\u62E1\u6563"
      CardText: "\u300E\u7D76\u53EB\u3068\u611B\u7D76\u306E\u9855\u73FE\u30FB\u30EB\u30EB\u30CA\u30A4\uFF06\u30F4\u30A1\u30FC\u30CA\u30EC\u30AF\u300F2\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\u305D\u308C\u306F\u3010\u7A81\u9032\u3011\u3092\u6301\u3064\u3002"
    - ID: 3511
      Name: "\u611B\u7D76\u306E\u98DB\u7FD4"
      CardText: "\u81EA\u5206\u306E\u5834\u306E\u300E\u7D76\u53EB\u3068\u611B\u7D76\u306E\u9855\u73FE\u30FB\u30EB\u30EB\u30CA\u30A4\uFF06\u30F4\u30A1\u30FC\u30CA\u30EC\u30AF\u300F1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306F\u3010\u75BE\u8D70\u3011\u3092\u6301\u3064\u3002"
    - ID: 3600
      Name: "\u5B89\u606F\u306E\u80AF\u5B9A\u8005"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u5B89\u606F\u306E\u80AF\u5B9A\u8005\u300F\u3092\u6301\u3064\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_4\u3011\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u3053\u306E\u30BF\u30FC\u30F3\u4E2D\u306B\u81EA\u5206\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u653B\u6483\u3057\u3066\u3044\u306A\u3044\u306A\u3089\u3001\u81EA\u5206\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306F-2/-0\u3057\u3066\u3010\u5B88\u8B77\u3011\u3092\u6301\u3064\u3002"
    - ID: 3601
      Name: "\u8056\u9A0E\u58EB\u306E\u56E3\u54E1"
      CardText: "\u3010\u5B88\u8B77\u3011\n\u3053\u308C\u306E\u653B\u6483\u529B\u304B\u4F53\u529B\u304C\u5834\u3067+\u3055\u308C\u305F\u3068\u304D\u3001\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30921\u56DE\u5FA9\u3002"
    - ID: 3602
      Name: "\u30BB\u30A4\u30F3\u30C8\u30D5\u30E9\u30C3\u30B7\u30E5"
      CardText: "\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306B3\u30C0\u30E1\u30FC\u30B8\u3002\n\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_8\u3011\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30893\u679A\u3092\u5F15\u304F\u3002\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30923\u56DE\u5FA9\u3002"
    - ID: 3603
      Name: "\u5B89\u606F\u306E\u7948\u7977\u8005"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u5B89\u606F\u306E\u7948\u7977\u8005\u300F\u3092\u6301\u3064\u3002\n\u3010\u5B88\u8B77\u3011\n\u30AF\u30EC\u30B9\u30C8\n\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_4\u3011\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u3053\u306E\u30BF\u30FC\u30F3\u4E2D\u306B\u81EA\u5206\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u653B\u6483\u3057\u3066\u3044\u306A\u3044\u306A\u3089\u3001\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30921\u56DE\u5FA9\u3002"
    - ID: 3604
      Name: "\u5B89\u606F\u306E\u795E\u6BBF"
      CardText: "\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_4\u3011\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30922\u56DE\u5FA9\u3002\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u306F\u3010\u30D0\u30EA\u30A2\u3011\u3092\u6301\u3064\u3002\n\u3010\u30A2\u30AF\u30C8\u3011\u3053\u308C\u306E\u30AB\u30A6\u30F3\u30C8\u3092-X\u3059\u308B\u3002X\u306F\u81EA\u5206\u306E\u30AF\u30EC\u30B9\u30C8\u306E\u6570\u3067\u3042\u308B\u3002"
    - ID: 3605
      Name: "\u6709\u7FFC\u306E\u7345\u5B50\u50CF"
      CardText: "\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_3\u3011\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u300E\u30DB\u30FC\u30EA\u30FC\u30D5\u30A1\u30EB\u30B3\u30F3\u300F1\u679A\u3068\u300E\u30DB\u30FC\u30EA\u30FC\u30D5\u30EC\u30A4\u30E0\u30BF\u30A4\u30AC\u30FC\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\n\u30B3\u30B9\u30C81\u3010\u30A2\u30AF\u30C8\u3011\u3053\u308C\u306E\u30AB\u30A6\u30F3\u30C8\u3092-1\u3059\u308B\u3002"
    - ID: 3606
      Name: "\u5B89\u606F\u306E\u56E3\u7D50\u8005"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u3092\u7834\u58CA\u3002\n\u3010\u9032\u5316\u6642\u3011\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u5B89\u606F\u306E\u56E3\u7D50\u8005\u300F\u3092\u6301\u3064\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_4\u3011\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u3053\u306E\u30BF\u30FC\u30F3\u4E2D\u306B\u81EA\u5206\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u653B\u6483\u3057\u3066\u3044\u306A\u3044\u306A\u3089\u3001\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u3089\u4F53\u529B4\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u5F15\u304F\u3002"
    - ID: 3607
      Name: "\u8F1D\u304F\u5931\u610F"
      CardText: "\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_4\u3011\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u3068\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u306B4\u30C0\u30E1\u30FC\u30B8\u3092\u5272\u308A\u3075\u308B\u3002\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30924\u56DE\u5FA9\u3002\n\u3010\u30A2\u30AF\u30C8\u3011\u3053\u308C\u306E\u30AB\u30A6\u30F3\u30C8\u3092-X\u3059\u308B\u3002X\u306F\u81EA\u5206\u306E\u30AF\u30EC\u30B9\u30C8\u306E\u6570\u3067\u3042\u308B\u3002"
    - ID: 3608
      Name: "\u7D76\u671B\u306E\u9855\u73FE\u30FB\u30DE\u30FC\u30A6\u30A3\u30F3"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u7D76\u671B\u306E\u5954\u6D41\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002\n\u3010\u9032\u5316\u6642\u3011\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u7D76\u671B\u306E\u9855\u73FE\u30FB\u30DE\u30FC\u30A6\u30A3\u30F3\u300F\u3092\u6301\u3064\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u3053\u306E\u30BF\u30FC\u30F3\u4E2D\u306B\u81EA\u5206\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u653B\u6483\u3057\u3066\u3044\u306A\u3044\u306A\u3089\u3001\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u3068\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u306BX\u30C0\u30E1\u30FC\u30B8\u3092\u5272\u308A\u3075\u308B\u3002X\u306F\u81EA\u5206\u306E\u30AF\u30EC\u30B9\u30C8\u306E\u6570\u3067\u3042\u308B\u3002"
    - ID: 3609
      Name: "\u5B89\u606F\u306E\u7D99\u627F\u8005\u30FB\u30D2\u30E1\u30AB"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u5B89\u606F\u306E\u7D99\u627F\u8005\u30FB\u30D2\u30E1\u30AB\u300F\u3092\u6301\u3064\u3002\n\u3010\u8D85\u9032\u5316\u6642\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306F\u653B\u6483\u529B4\u306B\u306A\u308B\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_4\u3011\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u81EA\u5206\u306E\u5834\u306B\u300E\u5B89\u606F\u306E\u7D99\u627F\u8005\u30FB\u30D2\u30E1\u30AB\u300F\u304C\u3042\u308B\u306A\u3089\u3001\u76F8\u624B\u306E\u5834\u306E\u653B\u6483\u529B4\u4EE5\u4E0B\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E0X\u679A\u306F\u300C\u30D5\u30A9\u30ED\u30EF\u30FC\u3084\u30EA\u30FC\u30C0\u30FC\u3092\u653B\u6483\u3067\u304D\u306A\u3044\u3002\u300D\u3068\u300C\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u3053\u308C\u3092\u6D88\u6EC5\u3002\u300D\u3092\u6301\u3064\u3002X\u306F\u81EA\u5206\u306E\u30AF\u30EC\u30B9\u30C8\u306E\u6570\u3067\u3042\u308B\u3002"
    - ID: 3610
      Name: "\u7D76\u671B\u306E\u5954\u6D41"
      CardText: "\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u3092\u6D88\u6EC5\u3002\u81EA\u5206\u306E\u30AF\u30EC\u30B9\u30C8\u3059\u3079\u3066\u306E\u30AB\u30A6\u30F3\u30C8\u3092+1\u3059\u308B\u3002"
    - ID: 3700
      Name: "\u7834\u58CA\u306E\u80AF\u5B9A\u8005"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3053\u308C\u306F+X/+X\u3059\u308B\u3002X\u306F\u81EA\u5206\u306E\u5834\u306E\u4ED6\u306E\u30AB\u30FC\u30C9\u306E\u679A\u6570\u3067\u3042\u308B\u3002\u81EA\u5206\u306E\u5834\u306E\u4ED6\u306E\u30AB\u30FC\u30C9\u3059\u3079\u3066\u3092\u7834\u58CA\u3002\n\u3010\u5B88\u8B77\u3011"
    - ID: 3701
      Name: "\u97F3\u901F\u306E\u98DB\u884C\u5175"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u30C7\u30B9\u30C8\u30ED\u30A4\u30A2\u30FC\u30C6\u30A3\u30D5\u30A1\u30AF\u30C8\u03B3\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\n\u3010\u9032\u5316\u6642\u3011\u81EA\u5206\u306E\u5834\u306E\u30A2\u30FC\u30C6\u30A3\u30D5\u30A1\u30AF\u30C8\u30FB\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306F+3/+3\u3059\u308B\u3002"
    - ID: 3702
      Name: "\u30B9\u30C8\u30EA\u30F3\u30B0\u30A2\u30B5\u30EB\u30C8"
      CardText: "\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u3092\u7834\u58CA\u3002\u300E\u64CD\u308A\u4EBA\u5F62\u300F2\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002"
    - ID: 3703
      Name: "\u7834\u58CA\u306E\u7948\u7977\u8005"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u5834\u306E\u4ED6\u306E\u30AB\u30FC\u30C91\u679A\u3092\u9078\u3076\u3002\u9078\u3093\u3060\u306A\u3089\u3001\u305D\u308C\u3092\u7834\u58CA\u3002\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306B2\u30C0\u30E1\u30FC\u30B8\u3002\n\u3010\u9032\u5316\u6642\u3011\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3068\u540C\u3058\u80FD\u529B\u304C\u50CD\u304F\u3002"
    - ID: 3704
      Name: "\u30D5\u30A3\u30FC\u30EB\u30C9\u30A8\u30F3\u30B8\u30CB\u30A2"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u624B\u672D1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u3092\u6368\u3066\u308B\u3002\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30893\u679A\u3092\u5F15\u304F\u3002"
    - ID: 3705
      Name: "\u7834\u58CA\u306E\u8352\u91CE"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u5834\u306E\u4ED6\u306E\u30AB\u30FC\u30C91\u679A\u3092\u9078\u3076\u3002\u9078\u3093\u3060\u306A\u3089\u3001\u305D\u308C\u3092\u7834\u58CA\u3002\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30892\u679A\u3092\u5F15\u304F\u3002\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30891\u679A\u3092\u5F15\u304F\u3002"
    - ID: 3706
      Name: "\u7834\u58CA\u306E\u56E3\u7D50\u8005"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E0X\u679A\u3092\u7834\u58CA\u3002X\u306F\u81EA\u5206\u306E\u5834\u306E\u4ED6\u306E\u30AB\u30FC\u30C9\u306E\u679A\u6570\u3067\u3042\u308B\u3002\u81EA\u5206\u306E\u5834\u306E\u4ED6\u306E\u30AB\u30FC\u30C9\u3059\u3079\u3066\u3092\u7834\u58CA\u3002"
    - ID: 3707
      Name: "\u6BB2\u6EC5\u306E\u6B4C\u58F0"
      CardText: "\u81EA\u5206\u306E\u5834\u306E\u30AB\u30FC\u30C91\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u3092\u7834\u58CA\u3002\u300E\u65B0\u7D04\u30FB\u767D\u306E\u7AE0\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002"
    - ID: 3708
      Name: "\u7834\u58CA\u306E\u7D99\u627F\u8005\u30FB\u30A2\u30AF\u30B7\u30A2"
      CardText: "\u3010\u5B88\u8B77\u3011\n\u80FD\u529B\u306B\u3088\u3063\u3066\u7834\u58CA\u3067\u304D\u306A\u3044\u3002\n\u3010\u8D85\u9032\u5316\u6642\u3011\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u306BX\u30C0\u30E1\u30FC\u30B8\u3002X\u306F\u81EA\u5206\u306E\u5834\u306E\u4ED6\u306E\u30AB\u30FC\u30C9\u306E\u679A\u6570\u3067\u3042\u308B\u3002\u81EA\u5206\u306E\u5834\u306E\u4ED6\u306E\u30AB\u30FC\u30C9\u3059\u3079\u3066\u3092\u7834\u58CA\u3002"
    - ID: 3709
      Name: "\u594F\u7D76\u306E\u9855\u73FE\u30FB\u30EA\u30FC\u30B7\u30A7\u30CA"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u594F\u7D76\u306E\u72EC\u5531\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002\n\u80FD\u529B\u306B\u3088\u3063\u3066\u7834\u58CA\u3067\u304D\u306A\u3044\u3002\n\u3010\u9032\u5316\u6642\u3011\u300E\u65B0\u7D04\u30FB\u767D\u306E\u7AE0\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002"
    - ID: 3710
      Name: "\u594F\u7D76\u306E\u72EC\u5531"
      CardText: "\u81EA\u5206\u306E\u5834\u306E\u30AB\u30FC\u30C91\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u3092\u7834\u58CA\u3002\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306B4\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 3711
      Name: "\u65B0\u7D04\u30FB\u767D\u306E\u7AE0"
      CardText: "\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_1\u3011\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30921\u56DE\u5FA9\u3002\u300E\u65B0\u7D04\u30FB\u9ED2\u306E\u7AE0\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002"
    - ID: 3712
      Name: "\u65B0\u7D04\u30FB\u9ED2\u306E\u7AE0"
      CardText: "\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_1\u3011\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u306B1\u30C0\u30E1\u30FC\u30B8\u3002\u300E\u65B0\u7D04\u30FB\u767D\u306E\u7AE0\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002"
  - name: SkyboundDragons
    list:
    - ID: 4000
      Name: "\u611B\u3059\u3079\u304D\u76F8\u68D2\u30FB\u30D3\u30A3"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u8D85\u9032\u5316\u53EF\u80FD\u30BF\u30FC\u30F3\u306A\u3089\u3001\u3053\u308C\u306F\u9032\u5316\u3059\u308B\u3002"
    - ID: 4001
      Name: "\u7A7A\u99C6\u3051\u308B\u5E87\u8B77\u8005\u30FB\u30AB\u30BF\u30EA\u30CA"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u5965\u7FA9\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E02\u679A\u306B5\u30C0\u30E1\u30FC\u30B8\u3002\n\u3010\u5B88\u8B77\u3011\n\u53D7\u3051\u308B4\u4EE5\u4E0A\u306E\u30C0\u30E1\u30FC\u30B8\u30923\u306B\u3059\u308B\u3002"
    - ID: 4002
      Name: "\u30B3\u30B9\u30E2\u30B9\u306E\u5FA1\u4F7F\u3044\u30FB\u30E6\u30CB"
      CardText: "\u3010\u30AA\u30FC\u30E9\u3011\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u81EA\u5206\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u3068\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30921\u56DE\u5FA9\u3002"
    - ID: 4003
      Name: "\u7A7A\u306E\u547D\u904B\u3092\u63E1\u308B\u5C11\u5973\u30FB\u30EB\u30EA\u30A2"
      CardText: "\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_8\u3011\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u3089\u30B3\u30B9\u30C87\u4EE5\u4E0A\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u5F15\u304F\u3002\u81EA\u5206\u306EPP\u30927\u56DE\u5FA9\u3002\n\u3010\u30D0\u30EA\u30A2\u3011"
    - ID: 4004
      Name: "\u84BC\u3044\u7A7A\u3092\u5F81\u304F\u9A0E\u7A7A\u58EB\u30FB\u30B0\u30E9\u30F3\uFF06\u30B8\u30FC\u30BF"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u30E2\u30FC\u30C9\u30111\u3064\u3092\u9078\u3093\u3067\u305D\u306E\u80FD\u529B\u304C\u50CD\u304F\u3002\u3010\u5965\u7FA9\u3011\u3053\u308C\u306F\u9032\u5316\u3059\u308B\u3002\n\uFF081\uFF09\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306B5\u30C0\u30E1\u30FC\u30B8\u3002\n\uFF082\uFF09\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u3089\u30D5\u30A9\u30ED\u30EF\u30FC2\u679A\u3092\u5F15\u304F\u3002"
    - ID: 4005
      Name: "\u5929\u53F8\u9577\u306E\u5F8C\u7D99\u30FB\u30B5\u30F3\u30C0\u30EB\u30D5\u30A9\u30F3"
      CardText: "\u30C7\u30C3\u30AD\u3067\u50CD\u304F\u3002\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u958B\u59CB\u6642\u3001\u3053\u306E\u30D0\u30C8\u30EB\u4E2D\u306B\u81EA\u5206\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u9032\u5316\u3057\u305F\u56DE\u6570\u304C6\u4EE5\u4E0A\u306A\u3089\u3001\u3053\u308C\u3092\u3010\u76F4\u63A5\u53EC\u559A\u3011\u3059\u308B\u3002\n\u3053\u308C\u304C\u3010\u76F4\u63A5\u53EC\u559A\u3011\u3055\u308C\u305F\u3068\u304D\u3001\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u5929\u53F8\u9577\u306E\u5F8C\u7D99\u30FB\u30B5\u30F3\u30C0\u30EB\u30D5\u30A9\u30F3\u300F\u3092\u6301\u3064\u3002\u3053\u308C\u3092\u624B\u672D\u306B\u623B\u3059\u3002\n\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u89E3\u653E\u5965\u7FA9\u3011\u300C\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306B2\u30C0\u30E1\u30FC\u30B8\u3002\u300D\u30925\u56DE\u884C\u3046\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_2\u3011\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u81EA\u5206\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u3068\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30921\u56DE\u5FA9\u3002"
    - ID: 4100
      Name: "\u30AB\u30EF\u30A4\u30A4\u82B1\u30DE\u30EB\u30FB\u30DE\u30CA\u30DE\u30EB"
      CardText: "\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u3053\u308C\u306F\u9032\u5316\u3059\u308B\u3002\n\u3053\u308C\u304C\u9032\u5316\u3057\u305F\u3068\u304D\u3001\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306B1\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 4101
      Name: "\u611B\u618E\u306E\u821E\u624B\u30FB\u30B3\u30A6\uFF06\u30E8\u30A6"
      CardText: "1\u30BF\u30FC\u30F3\u306B2\u56DE\u653B\u6483\u3067\u304D\u308B\u3002\n\u3010\u653B\u6483\u6642\u3011\u81EA\u5206\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u3068\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30923\u56DE\u5FA9\u3002"
    - ID: 4102
      Name: "\u7B92\u661F"
      CardText: "\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306B4\u30C0\u30E1\u30FC\u30B8\u3002\u81EA\u5206\u306E\u5834\u306B\u9032\u5316\u5F8C\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u3042\u308B\u306A\u3089\u3001\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30891\u679A\u3092\u5F15\u304F\u3002"
    - ID: 4103
      Name: "\u7F8E\u7CA7\u306E\u4E59\u5973\u30FB\u30AF\u30ED\u30A8"
      CardText: "\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_8\u3011\u81EA\u5206\u306E\u624B\u672D\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\u3053\u308C\u3092\u624B\u672D\u306B\u623B\u3059\u3002"
    - ID: 4104
      Name: "\u7DCB\u7114\u306E\u8E0A\u308A\u5B50\u30FB\u30A2\u30F3\u30B9\u30EA\u30A2"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306F\u3010\u30D0\u30EA\u30A2\u3011\u3092\u6301\u3064\u3002"
    - ID: 4105
      Name: "\u7DBA\u7F85\u661F"
      CardText: "\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306B2\u30C0\u30E1\u30FC\u30B8\u3002\u3010\u30B3\u30F3\u30DC_5\u3011\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u7DBA\u7F85\u661F\u300F\u3092\u6301\u3064\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_1\u3011\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u306B1\u30C0\u30E1\u30FC\u30B8\u3002\u300E\u7DBA\u7F85\u661F\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002"
    - ID: 4106
      Name: "\u8679\u8272\u306E\u5F13\u4F7F\u3044\u30FB\u30AF\u30D4\u30BF\u30F3"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u89E3\u653E\u5965\u7FA9\u3011\u3053\u308C\u306F\u9032\u5316\u3059\u308B\u3002\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u306B3\u30C0\u30E1\u30FC\u30B8\u3002\n\u3053\u308C\u304C\u9032\u5316\u3057\u305F\u3068\u304D\u3001\u300C\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306B1\u30C0\u30E1\u30FC\u30B8\u3002\u300D\u30927\u56DE\u884C\u3046\u3002"
    - ID: 4107
      Name: "\u30A2\u30EB\u30D5\u30D8\u30A4\u30E0"
      CardText: "\u3010\u30E2\u30FC\u30C9\u30111\u3064\u3092\u9078\u3093\u3067\u305D\u306E\u80FD\u529B\u304C\u50CD\u304F\u3002\u3010\u89E3\u653E\u5965\u7FA9\u30111\u3064\u3092\u9078\u3076\u306E\u3067\u306F\u306A\u304F\u3059\u3079\u3066\u3002\n\uFF081\uFF09\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30891\u679A\u3092\u5F15\u304F\u3002\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30921\u56DE\u5FA9\u3002\n\uFF082\uFF09\u81EA\u5206\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306F+1/+0\u3057\u3066\u3010\u7A81\u9032\u3011\u3092\u6301\u3064\u3002\n\uFF083\uFF09\u81EA\u5206\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306F+0/+1\u3057\u3066\u3010\u5B88\u8B77\u3011\u3092\u6301\u3064\u3002"
    - ID: 4108
      Name: "\u98A8\u306E\u7406\u30FB\u30A4\u30FC\u30A6\u30A3\u30E4"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u5965\u7FA9\u3011\u81EA\u5206\u306EEP\u30921\u56DE\u5FA9\u3002"
    - ID: 4109
      Name: "\u8ABF\u548C\u306E\u821E\u624B\u30FB\u30E6\u30A8\u30EB\uFF06\u30BD\u30B7\u30A8"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300C\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306B4\u30C0\u30E1\u30FC\u30B8\u3002\u300D\u30922\u56DE\u884C\u3046\u3002\n\u3010\u8D85\u9032\u5316\u6642\u3011\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u8ABF\u548C\u306E\u821E\u624B\u30FB\u30E6\u30A8\u30EB\uFF06\u30BD\u30B7\u30A8\u300F\u3092\u6301\u3064\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_4\u3011\n\u81EA\u5206\u304C\u30D5\u30A9\u30ED\u30EF\u30FC\u3092\u30D7\u30EC\u30A4\u3057\u305F\u3068\u304D\u3001\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u3054\u3068\u306B1\u56DE\u3001\u305D\u308C\u306F\u9032\u5316\u3059\u308B\u3002"
    - ID: 4200
      Name: "\u4FE1\u5FF5\u306E\u8E74\u6483\u30FB\u30E9\u30F3\u30C9\u30EB"
      CardText: "\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_5\u3011\u3053\u308C\u306F\u3010\u75BE\u8D70\u3011\u3092\u6301\u3064\u3002"
    - ID: 4201
      Name: "\u6C7A\u610F\u306E\u8F1D\u7ADC\u30FB\u30A2\u30FC\u30B5\u30FC"
      CardText: "\u3010\u5B88\u8B77\u3011\n\u3010\u9032\u5316\u6642\u3011\u300E\u8FF7\u5922\u306E\u7345\u5B50\u30FB\u30E2\u30EB\u30C9\u30EC\u30C3\u30C9\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002"
    - ID: 4202
      Name: "\u8FF7\u5922\u306E\u7345\u5B50\u30FB\u30E2\u30EB\u30C9\u30EC\u30C3\u30C9"
      CardText: "\u3010\u75BE\u8D70\u3011\n\u3010\u9032\u5316\u6642\u3011\u300E\u6C7A\u610F\u306E\u8F1D\u7ADC\u30FB\u30A2\u30FC\u30B5\u30FC\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002"
    - ID: 4203
      Name: "\u71C3\u3048\u6EFE\u308B\u95D8\u5FD7\u30FB\u30D5\u30A7\u30B6\u30FC"
      CardText: '-'
