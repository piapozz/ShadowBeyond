      CardText: "\u3010\u75BE\u8D70\u3011\n\u81EA\u5206\u306E\u5834\u306E\u4ED6\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u653B\u6483\u3057\u305F\u3068\u304D\u3001\u3053\u308C\u306F+1/+0\u3059\u308B\u3002"
