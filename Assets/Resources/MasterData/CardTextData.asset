      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u3089\u30A2\u30DF\u30E5\u30EC\u30C3\u30C81\u679A\u3092\u5F15\u304F\u3002\n\u3010\u9032\u5316\u6642\u3011\u81EA\u5206\u306E\u624B\u672D\u306E\u30A2\u30DF\u30E5\u30EC\u30C3\u30C81\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306E\u30B3\u30B9\u30C8\u3092-1\u3059\u308B\u3002"
