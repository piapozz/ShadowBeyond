      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u9EC4\u91D1\u306E\u9774\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u300E\u9EC4\u91D1\u306E\u676F\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002"
