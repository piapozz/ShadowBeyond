    - ID: 1613
      Name: "\u5927\u3044\u306A\u308B\u71BE\u5929\u4F7F\u30FB\u30E9\u30D4\u30B9"
      CardText: "\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u5927\u3044\u306A\u308B\u71BE\u5929\u4F7F\u30FB\u30E9\u30D4\u30B9\u300F\u3092\u6301\u3064\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_2\u3011\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u300E\u5927\u3044\u306A\u308B\u71BE\u5929\u4F7F\u30FB\u30E9\u30D4\u30B9\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\u305D\u308C\u306F\u3010\u75BE\u8D70\u3011\u3092\u6301\u3064\u3002"
    - ID: 1614
