      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300C\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306B2\u30C0\u30E1\u30FC\u30B8\u3002\u300D\u30921\u56DE\u884C\u3046\u3002\u81EA\u5206\u306E\u5834\u306E\u30A2\u30DF\u30E5\u30EC\u30C3\u30C8\u306E\u679A\u6570\u304C2\u4EE5\u4E0A\u306A\u3089\u30011\u56DE\u3067\u306F\u306A\u304F2\u56DE\u3002"
    - ID: 2604
      Name: "\u6F54\u7656\u306E\u5BE9\u5224\u8005"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u3092\u6D88\u6EC5\u3002"
    - ID: 2605
      Name: "\u30C7\u30A3\u30D0\u30A4\u30F3\u30AC\u30FC\u30C9"
      CardText: "\u81EA\u5206\u306E\u5834\u306E\u3010\u5B88\u8B77\u3011\u3092\u6301\u3064\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306F+0/+1\u3059\u308B\u3002\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306BX\u30C0\u30E1\u30FC\u30B8\u3002X\u306F\u9078\u3093\u3060\u30D5\u30A9\u30ED\u30EF\u30FC\u306E\u4F53\u529B\u3067\u3042\u308B\u3002"
    - ID: 2606
      Name: "\u901F\u65AD\u306E\u5203\u30FB\u30A2\u30CB\u30A8\u30B9"
      CardText: "\u3010\u75BE\u8D70\u3011\n\u3010\u653B\u6483\u6642\u3011\u81EA\u5206\u306E\u5834\u306E\u30A2\u30DF\u30E5\u30EC\u30C3\u30C8\u306E\u679A\u6570\u304C2\u4EE5\u4E0A\u306A\u3089\u3001\u76F8\u624B\u306E\u5834\u306E\u4EA4\u6226\u76F8\u624B\u3067\u306A\u3044\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u3092\u7834\u58CA\u3002"
    - ID: 2607
      Name: "\u72C2\u304A\u3057\u304D\u6069\u5BF5"
      CardText: "\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u309210\u56DE\u5FA9\u3002\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u72C2\u304A\u3057\u304D\u6069\u5BF5\u300F\u3092\u6301\u3064\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_2\u3011\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u306B10\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 2608
      Name: "\u55DA\u54BD\u306E\u8056\u9A0E\u58EB\u30FB\u30A6\u30A3\u30EB\u30D0\u30FC\u30C8"
      CardText: "\u3010\u5B88\u8B77\u3011\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u300E\u8056\u9A0E\u5175\u300F2\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\n\u3010\u9032\u5316\u6642\u3011\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u55DA\u54BD\u306E\u8056\u9A0E\u58EB\u30FB\u30A6\u30A3\u30EB\u30D0\u30FC\u30C8\u300F\u3092\u6301\u3064\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u81EA\u5206\u306E\u3010\u5B88\u8B77\u3011\u3092\u6301\u3064\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u5834\u306B\u51FA\u305F\u3068\u304D\u3001\u305D\u308C\u306F+1/+2\u3059\u308B\u3002"
    - ID: 2609
      Name: "\u5929\u306E\u5B88\u8B77\u795E\u30FB\u30A2\u30A4\u30C6\u30FC\u30EB"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u306E\u30B3\u30B9\u30C83\u4EE5\u4E0B\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E03\u7A2E\u985E\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\n\u3010\u5B88\u8B77\u3011\n\u3010\u8D85\u9032\u5316\u6642\u3011\u81EA\u5206\u306E\u5834\u306E\u4ED6\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306F+0/+2\u3057\u3066\u3010\u30AA\u30FC\u30E9\u3011\u3092\u6301\u3064\u3002"
    - ID: 2610
      Name: "\u8056\u9A0E\u5175"
      CardText: "\u3010\u5B88\u8B77\u3011"
    - ID: 2700
      Name: "\u30D1\u30DA\u30C3\u30C8\u30AD\u30E3\u30C3\u30C8"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u5834\u306B\u8D85\u9032\u5316\u5F8C\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u3042\u308B\u306A\u3089\u3001\u300E\u64CD\u308A\u4EBA\u5F62\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002\u305D\u308C\u306F+3/+0\u3059\u308B\u3002\n\u3010\u7A81\u9032\u3011"
    - ID: 2701
      Name: "\u30A8\u30F3\u30B8\u30F3\u30D6\u30EC\u30A4\u30C0\u30FC"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u30A2\u30BF\u30C3\u30AF\u30A2\u30FC\u30C6\u30A3\u30D5\u30A1\u30AF\u30C8\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\u300E\u30D1\u30B9\u30C8\u30FB\u30B3\u30A2\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002\n\u3010\u9032\u5316\u6642\u3011\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3068\u540C\u3058\u80FD\u529B\u304C\u50CD\u304F\u3002"
    - ID: 2702
      Name: "\u30A2\u30FC\u30C6\u30A3\u30D5\u30A1\u30AF\u30C8\u30AB\u30BF\u30D1\u30EB\u30C8"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u30D5\u30E5\u30FC\u30C1\u30E3\u30FC\u30FB\u30B3\u30A2\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002\n\u30B3\u30B9\u30C83\u3010\u30A2\u30AF\u30C8\u3011\u3053\u308C\u3092\u7834\u58CA\u3002\u81EA\u5206\u306E\u624B\u672D\u306E\u30B3\u30B9\u30C85\u4EE5\u4E0B\u306E\u30A2\u30FC\u30C6\u30A3\u30D5\u30A1\u30AF\u30C8\u30FB\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306E\u30B3\u30D4\u30FC1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\u305D\u308C\u306F\u300C\u76F8\u624B\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u3053\u308C\u3092\u7834\u58CA\u3002\u300D\u3092\u6301\u3064\u3002"
    - ID: 2703
      Name: "\u30CF\u30FC\u30C8\u30B9\u30ED\u30FC\u30BF\u30FC\u30FB\u30D5\u30A3\u30A2"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u624B\u672D\u306E\u4EBA\u5F62\u30FB\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306F\u300E\u30C9\u30FC\u30EB\u30B9\u30ED\u30FC\u30BF\u30FC\u300F\u306B\u5909\u8EAB\u3059\u308B\u3002\n\u3010\u5FC5\u6BBA\u3011"
    - ID: 2704
      Name: "\u30C7\u30A3\u30B9\u30DA\u30A2\u30ED\u30FC\u30C9\u30FB\u30A2\u30AD\u30E0"
      CardText: "\u3010\u9032\u5316\u6642\u3011\u76F8\u624B\u306E\u5834\u306E\u653B\u6483\u529B4\u4EE5\u4E0B\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u3092\u6D88\u6EC5\u3057\u3066\u3001\u30B3\u30D4\u30FC1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002"
    - ID: 2705
      Name: "\u30A4\u30AB\u30ED\u30B9\u306E\u98DB\u7FD4"
      CardText: "\u81EA\u5206\u306E\u624B\u672D\u306E\u30A2\u30FC\u30C6\u30A3\u30D5\u30A1\u30AF\u30C8\u30FB\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306F\u3010\u7A81\u9032\u3011\u3068\u300C\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30891\u679A\u3092\u5F15\u304F\u3002\u300D\u3092\u6301\u3064\u3002"
    - ID: 2706
      Name: "\u6697\u7344\u306E\u6B8B\u5149\u30FB\u30B8\u30E3\u30B9\u30D1\u30FC"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u30D1\u30B9\u30C8\u30FB\u30B3\u30A2\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002\n\u3010\u9032\u5316\u6642\u3011\u81EA\u5206\u306E\u624B\u672D\u306E\u30A2\u30FC\u30C6\u30A3\u30D5\u30A1\u30AF\u30C8\u30FB\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306F\u3010\u5B88\u8B77\u3011\u3068\u300C\u80FD\u529B\u306B\u3088\u3063\u3066\u7834\u58CA\u3067\u304D\u306A\u3044\u3002\u300D\u3092\u6301\u3064\u3002"
    - ID: 2707
      Name: "\u5FC3\u6709\u308B\u5171\u95D8"
      CardText: "\u300E\u30ED\u30A4\u30C9\u300F1\u679A\u3068\u300E\u30F4\u30A3\u30AF\u30C8\u30EA\u30A2\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002"
    - ID: 2708
      Name: "\u30B7\u30F3\u30D5\u30A9\u30CB\u30A2\u30CF\u30FC\u30C8\u30FB\u30C4\u30F4\u30A1\u30A4"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u30F4\u30A3\u30AF\u30C8\u30EA\u30A2\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\n\u81EA\u5206\u306E\u4EBA\u5F62\u30FB\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u5834\u306B\u51FA\u305F\u3068\u304D\u3001\u305D\u308C\u306F\u3010\u5B88\u8B77\u3011\u3092\u6301\u3064\u3002\n\u3010\u9032\u5316\u6642\u3011\u300E\u6539\u826F\u578B\u30FB\u64CD\u308A\u4EBA\u5F62\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002"
    - ID: 2709
      Name: "\u30DE\u30A4\u30F3\u30C9\u30A2\u30FC\u30C4\u30FB\u30AB\u30EB\u30E9"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u624B\u672D\u306E\u30B3\u30B9\u30C85\u4EE5\u4E0B\u306E\u30A2\u30FC\u30C6\u30A3\u30D5\u30A1\u30AF\u30C8\u30FB\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306E\u30B3\u30D4\u30FC1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\n\u3010\u8D85\u9032\u5316\u6642\u3011\u3053\u308C\u306F\u300C1\u30BF\u30FC\u30F3\u306B2\u56DE\u653B\u6483\u3067\u304D\u308B\u3002\u300D\u3092\u6301\u3064\u3002"
    - ID: 2710
      Name: "\u30C9\u30FC\u30EB\u30B9\u30ED\u30FC\u30BF\u30FC"
      CardText: "\u3010\u6F5C\u4F0F\u3011\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u300E\u30CF\u30FC\u30C8\u30B9\u30ED\u30FC\u30BF\u30FC\u30FB\u30D5\u30A3\u30A2\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002"
    - ID: 2711
      Name: "\u30F4\u30A3\u30AF\u30C8\u30EA\u30A2"
      CardText: "\u3010\u7A81\u9032\u3011\n\u3010\u653B\u6483\u6642\u3011\u30D5\u30A9\u30ED\u30EF\u30FC\u3078\u306E\u653B\u6483\u306A\u3089\u3001\u4EA4\u6226\u76F8\u624B\u306BX\u30C0\u30E1\u30FC\u30B8\u3002X\u306F\u3053\u308C\u306E\u653B\u6483\u529B\u3067\u3042\u308B\u3002"
  - name: HeirsOfTheOmen
    list:
    - ID: 3000
      Name: "\u5E72\u7D76\u306E\u4F7F\u5F92"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u5834\u306E\u4ED6\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306F+4/-4\u3059\u308B\u3002"
    - ID: 3001
      Name: "\u81F3\u9AD8\u306E\u51CC\u99D5"
      CardText: "\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30893\u679A\u3092\u5F15\u304F\u3002\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u306B\u91CD\u8907\u3059\u308B\u30AB\u30FC\u30C9\u304C\u306A\u3044\u306A\u3089\u3001\u81EA\u5206\u306EPP\u30923\u56DE\u5FA9\u3002"
    - ID: 3002
      Name: "\u5606\u304D\u306B\u7ACB\u3061\u3057\u8005"
      CardText: "\u624B\u672D\u3067\u50CD\u304F\u3002\u76F8\u624B\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u8D85\u9032\u5316\u3057\u305F\u3068\u304D\u3001\u3053\u308C\u306F\u3010\u5FC5\u6BBA\u3011\u3092\u6301\u3064\u3002\n\u3010\u5B88\u8B77\u3011"
    - ID: 3003
      Name: "\u52C7\u6C17\u306B\u6E80\u3061\u3057\u8005"
      CardText: "\u624B\u672D\u3067\u50CD\u304F\u3002\u76F8\u624B\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u8D85\u9032\u5316\u3057\u305F\u3068\u304D\u3001\u3053\u308C\u306F\u3010\u75BE\u8D70\u3011\u3092\u6301\u3064\u3002\n\u3010\u7A81\u9032\u3011"
    - ID: 3004
      Name: "\u8A66\u7DF4\u306E\u77F3\u677F"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u306E\u91CD\u8907\u3059\u308B\u30AB\u30FC\u30C9\u3092\u305D\u308C\u305E\u308C1\u679A\u306B\u306A\u308B\u3088\u3046\u306B\u6D88\u6EC5\u3002\n\u3010\u30A2\u30AF\u30C8\u3011\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30891\u679A\u3092\u5F15\u304F\u3002"
    - ID: 3005
      Name: "\u5E72\u7D76\u306E\u9855\u73FE\u30FB\u30AE\u30EB\u30CD\u30EA\u30FC\u30BC"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u5834\u306E\u4ED6\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306F+2/-2\u3059\u308B\u3002\u81EA\u5206\u3068\u76F8\u624B\u306EPP\u6700\u5927\u5024\u304C10\u306A\u3089\u3001\u300E\u5E72\u7D76\u306E\u7518\u9732\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002\n\u3010\u30C9\u30EC\u30A4\u30F3\u3011\n\u3010\u9032\u5316\u6642\u3011\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306F+2/-2\u3059\u308B\u3002"
    - ID: 3006
      Name: "\u7D76\u5927\u306E\u9855\u73FE\u30FB\u30DE\u30BC\u30EB\u30D9\u30A4\u30F3"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u7D76\u5927\u306E\u8A3C\u660E\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002\n\u3010\u9032\u5316\u6642\u3011\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u7D76\u5927\u306E\u9855\u73FE\u30FB\u30DE\u30BC\u30EB\u30D9\u30A4\u30F3\u300F\u3092\u6301\u3064\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u3053\u308C\u3092\u6301\u3063\u305F\u3068\u304D\u3001\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u3092\u3010\u30DE\u30BC\u30EB\u30D9\u30A4\u30F3\u30C7\u30C3\u30AD\u3011\u306B\u3059\u308B\u3002\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u306E\u4E0B\u306B\u3042\u308B\u6B7B\u795E\u306E\u30AB\u30FC\u30C9\u3092\u52DD\u5229\u306E\u30AB\u30FC\u30C9\u306B\u5909\u8EAB\u3055\u305B\u308B\u3002\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u81EA\u5206\u306E\u624B\u672D\u306E\u300E\u7D76\u5927\u306E\u8A3C\u660E\u300F\u3067\u306A\u3044\u30AB\u30FC\u30C9\u3059\u3079\u3066\u3092\u6368\u3066\u308B\u3002\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30896\u679A\u3092\u5F15\u304F\u3002"
