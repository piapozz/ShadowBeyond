      CardText: "\u3010\u6F5C\u4F0F\u3011\n\u3010\u5FC5\u6BBA\u3011"
    - ID: 4205
      Name: "\u6C37\u5FC3\u306E\u8987\u738B\u30FB\u30A2\u30B0\u30ED\u30F4\u30A1\u30EB"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306B3\u30C0\u30E1\u30FC\u30B8\u3002\n\u3010\u5A01\u5727\u3011"
    - ID: 4206
      Name: "\u771F\u738B\u306E\u5203\u30FB\u9EC4\u91D1\u306E\u9A0E\u58EB"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u30E2\u30FC\u30C9\u30111\u3064\u3092\u9078\u3093\u3067\u305D\u306E\u80FD\u529B\u304C\u50CD\u304F\u3002\n\uFF081\uFF09\u3053\u308C\u306F\u8D85\u9032\u5316\u3059\u308B\u3002\n\uFF082\uFF09\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306B4\u30C0\u30E1\u30FC\u30B8\u3002\n\uFF083\uFF09\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30924\u56DE\u5FA9\u3002\n\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_9\u30111\u3064\u3092\u9078\u3076\u306E\u3067\u306F\u306A\u304F\u3059\u3079\u3066\u3002"
    - ID: 4207
      Name: "\u30EA\u30C3\u30BF\u30FC\u30FB\u30B7\u30E5\u30CA\u30A4\u30C8"
      CardText: "\u3010\u30E2\u30FC\u30C9\u30111\u3064\u3092\u9078\u3093\u3067\u305D\u306E\u80FD\u529B\u304C\u50CD\u304F\u3002\n\uFF081\uFF09\u81EA\u5206\u306E\u5834\u306E\u30ED\u30A4\u30E4\u30EB\u30FB\u30D5\u30A9\u30ED\u30EF\u30FC\u5DE6\u304B\u30891\u679A\u306F\u300C1\u30BF\u30FC\u30F3\u306B2\u56DE\u653B\u6483\u3067\u304D\u308B\u3002\u300D\u3092\u6301\u3064\u3002\n\uFF082\uFF09\u81EA\u5206\u306E\u5834\u306E\u30ED\u30A4\u30E4\u30EB\u30FB\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306F+1/+1\u3057\u3066\u3010\u30D0\u30EA\u30A2\u3011\u3092\u6301\u3064\u3002\n\uFF083\uFF09\u81EA\u5206\u306EPP\u30922\u56DE\u5FA9\u3002\u81EA\u5206\u306EEP\u30921\u56DE\u5FA9\u3002\n\uFF084\uFF09\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30926\u56DE\u5FA9\u3002"
    - ID: 4208
      Name: "\u771F\u7D05\u3068\u7FA4\u9752\u30FB\u30BC\u30BF\uFF06\u30D9\u30A2\u30C8\u30EA\u30AF\u30B9"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u771F\u7D05\u3068\u7FA4\u9752\u30FB\u30BC\u30BF\uFF06\u30D9\u30A2\u30C8\u30EA\u30AF\u30B9\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\n\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_6\u3011\u305D\u308C\u306F\u3010\u5FC5\u6BBA\u3011\u3092\u6301\u3064\u3002\u3053\u308C\u306F\u3010\u75BE\u8D70\u3011\u3092\u6301\u3064\u3002\n\u3010\u7A81\u9032\u3011"
    - ID: 4209
      Name: "\u5341\u5929\u8846\u306E\u982D\u76EE\u30FB\u30B7\u30A8\u30C6"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u5965\u7FA9\u3011\u81EA\u5206\u306E\u5834\u306E\u9032\u5316\u524D\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306F\u9032\u5316\u3059\u308B\u3002\u3010\u89E3\u653E\u5965\u7FA9\u3011\u9032\u5316\u3059\u308B\u306E\u3067\u306F\u306A\u304F\u8D85\u9032\u5316\u3059\u308B\u3002"
    - ID: 4300
      Name: "\u3055\u3059\u3089\u3044\u306E\u5BB6\u5EAD\u6559\u5E2B\u30FB\u30B9\u30D5\u30E9\u30DE\u30FC\u30EB"
      CardText: "\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u81EA\u5206\u306E\u624B\u672D\u3059\u3079\u3066\u306FX\u56DE\u30B9\u30DA\u30EB\u30D6\u30FC\u30B9\u30C8\u3059\u308B\u3002X\u306F\u3053\u308C\u306E\u653B\u6483\u529B\u3067\u3042\u308B\u3002\n\u3010\u9032\u5316\u6642\u3011\u3053\u308C\u306F\u300C\u30D5\u30A9\u30ED\u30EF\u30FC\u3084\u30EA\u30FC\u30C0\u30FC\u3092\u653B\u6483\u3067\u304D\u306A\u3044\u3002\u300D\u3092\u6301\u3064\u3002"
    - ID: 4301
      Name: "\u4E0D\u53EF\u601D\u8B70\u306A\u54F2\u5B66\u8005\u30FB\u30D5\u30A3\u30E9\u30BD\u30D4\u30E9"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u3089\u30B9\u30DA\u30EB1\u679A\u3092\u5F15\u304F\u3002"
    - ID: 4302
      Name: "\u30EB\u30FC\u30F3\u30FB\u30EA\u30C1\u30E5\u30AA\u30EB"
      CardText: "\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306B6\u30C0\u30E1\u30FC\u30B8\u3002\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30923\u56DE\u5FA9\u3002"
    - ID: 4303
      Name: "\u8F9B\u82E6\u306E\u65C5\u8DEF\u30FB\u30DF\u30EC\u30A4\u30E6\uFF06\u30EA\u30BC\u30C3\u30C8"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u300E\u8F9B\u82E6\u306E\u65C5\u8DEF\u30FB\u30DF\u30EC\u30A4\u30E6\uFF06\u30EA\u30BC\u30C3\u30C8\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\u3010\u571F\u306E\u79D8\u8853_2\u3011\u305D\u308C\u3068\u3053\u308C\u306F\u9032\u5316\u3059\u308B\u3002"
    - ID: 4304
      Name: "\u5FA9\u8B90\u306E\u5360\u5E2B\u30FB\u30A8\u30BC\u30AF\u30EC\u30A4\u30F3"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC2\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306B4\u30C0\u30E1\u30FC\u30B8\u3002\u81EA\u5206\u306E\u5834\u306E\u571F\u306E\u5370\u3092+2\u3059\u308B\u3002"
    - ID: 4305
      Name: "\u30A2\u30F3\u30EA\u30FC\u30B7\u30E5"
      CardText: "\u3010\u30E2\u30FC\u30C9\u30111\u3064\u3092\u9078\u3093\u3067\u305D\u306E\u80FD\u529B\u304C\u50CD\u304F\u3002\n\uFF081\uFF09\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30891\u679A\u3092\u5F15\u304F\u3002\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306B4\u30C0\u30E1\u30FC\u30B8\u3002\n\uFF082\uFF09\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30892\u679A\u3092\u5F15\u304F\u3002\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E02\u679A\u306B4\u30C0\u30E1\u30FC\u30B8\u3002\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u306B2\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 4306
      Name: "\u61D0\u65E7\u306E\u9001\u308A\u706B\u30FB\u30A8\u30EB\u30E2\u30FC\u30C8"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306F\u80FD\u529B\u3059\u3079\u3066\u3092\u5931\u3046\u3002\u305D\u308C\u306B3\u30C0\u30E1\u30FC\u30B8\u3002\n\u3010\u8D85\u9032\u5316\u6642\u3011\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u61D0\u65E7\u306E\u9001\u308A\u706B\u30FB\u30A8\u30EB\u30E2\u30FC\u30C8\u300F\u3092\u6301\u3064\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u958B\u59CB\u6642\u3001\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u306B1\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 4307
      Name: "\u30A2\u30EB\u30B1\u30DF\u30C3\u30AF\u30FB\u30D5\u30EC\u30A2"
      CardText: "\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306B4\u30C0\u30E1\u30FC\u30B8\u3002\u81EA\u5206\u306E\u5834\u306E\u571F\u306E\u5370\u3092+1\u3059\u308B\u3002\u3010\u5965\u7FA9\u3011\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u306B2\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 4308
      Name: "\u6C34\u306E\u7406\u30FB\u30EF\u30E0\u30C7\u30E5\u30B9"
      CardText: "\u3010\u30B9\u30DA\u30EB\u30D6\u30FC\u30B9\u30C8\u6642\u3011\u3053\u308C\u306F+1/+1\u3059\u308B\u3002\n\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u624B\u672D\u3059\u3079\u3066\u306F1\u56DE\u30B9\u30DA\u30EB\u30D6\u30FC\u30B9\u30C8\u3059\u308B\u3002\n\u3010\u8D85\u9032\u5316\u6642\u3011\u3010\u30E2\u30FC\u30C9\u30111\u3064\u3092\u9078\u3093\u3067\u305D\u306E\u80FD\u529B\u304C\u50CD\u304F\u3002\n\uFF081\uFF09\u81EA\u5206\u306E\u5834\u306E\u4ED6\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306F\u3010\u30D0\u30EA\u30A2\u3011\u3092\u6301\u3064\u3002\n\uFF082\uFF09\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306BX\u30C0\u30E1\u30FC\u30B8\u3092\u5272\u308A\u3075\u308B\u3002X\u306F\u3053\u308C\u306E\u653B\u6483\u529B\u3067\u3042\u308B\u3002"
    - ID: 4309
      Name: "\u5929\u624D\u7F8E\u5C11\u5973\u932C\u91D1\u8853\u5E2B\u30FB\u30AB\u30EA\u30AA\u30B9\u30C8\u30ED"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u5834\u306E\u571F\u306E\u5370\u3092+2\u3059\u308B\u3002\u300E\u30A2\u30EB\u30B9\u30FB\u30DE\u30B0\u30CA\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002\u3010\u5965\u7FA9\u3011\u3053\u308C\u306F\u9032\u5316\u3059\u308B\u3002\u3010\u89E3\u653E\u5965\u7FA9\u3011\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u5929\u624D\u7F8E\u5C11\u5973\u932C\u91D1\u8853\u5E2B\u30FB\u30AB\u30EA\u30AA\u30B9\u30C8\u30ED\u300F\u3092\u6301\u3064\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u958B\u59CB\u6642\u3001\u3010\u571F\u306E\u79D8\u8853_1\u3011\u300E\u30A2\u30EB\u30B9\u30FB\u30DE\u30B0\u30CA\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002"
    - ID: 4400
      Name: "\u30E1\u30B0\u306E\u89AA\u53CB\u30FB\u307E\u308A\u3063\u307A"
      CardText: "\u624B\u672D\u3067\u50CD\u304F\u3002\u81EA\u5206\u306E\u5143\u306E\u30B3\u30B9\u30C83\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u8D85\u9032\u5316\u3057\u305F\u3068\u304D\u3001\u30BF\u30FC\u30F3\u7D42\u4E86\u307E\u3067\u3001\u3053\u308C\u306E\u30B3\u30B9\u30C8\u30920\u306B\u3059\u308B\u3002\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u81EA\u5206\u306E\u5834\u306E\u8D85\u9032\u5316\u5F8C\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306F+1/+1\u3059\u308B\u3002"
    - ID: 4401
      Name: "\u5927\u6D77\u3092\u8FFD\u3046\u8005\u30FB\u30B8\u30E7\u30A8\u30EB"
      CardText: "\u3010\u5B88\u8B77\u3011\n\u3010\u30AA\u30FC\u30E9\u3011"
    - ID: 4402
      Name: "\u30AF\u30EC\u30C3\u30BB\u30F3\u30C8\u30FB\u30C1\u30E5\u30FC\u30D6\u30FB\u30E9\u30A4\u30C9"
      CardText: "\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u30AF\u30EC\u30C3\u30BB\u30F3\u30C8\u30FB\u30C1\u30E5\u30FC\u30D6\u30FB\u30E9\u30A4\u30C9\u300F\u3092\u6301\u3064\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_4\u3011\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u81EA\u5206\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306F+1/+1\u3059\u308B\u3002"
    - ID: 4403
      Name: "\u51CD\u3066\u3064\u304F\u5B9A\u3081\u30FB\u30A4\u30B7\u30E5\u30DF\u30FC\u30EB"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306EPP\u6700\u5927\u5024\u304C10\u306A\u3089\u3001\u3053\u308C\u306F\u9032\u5316\u3059\u308B\u3002\n\u3053\u308C\u304C\u9032\u5316\u3057\u305F\u3068\u304D\u3001\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306B3\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 4404
      Name: "\u7D14\u6734\u306E\u92FC\u4F53\u30FB\u30E0\u30B2\u30F3"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u89E3\u653E\u5965\u7FA9\u3011\u3053\u308C\u306F\u3010\u75BE\u8D70\u3011\u3092\u6301\u3064\u3002\n\u3010\u8D85\u9032\u5316\u6642\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC2\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u3092\u7834\u58CA\u3002"
    - ID: 4405
      Name: "\u30E9\u30F4\u30DE\u30C3\u30AF\u30B9\u30FB\u30DC\u30F3\u30D0\u30FC"
      CardText: "\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306B3\u30C0\u30E1\u30FC\u30B8\u3002\u76F8\u624B\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u307E\u3067\u3001\u305D\u308C\u306F\u300C\u30D5\u30A9\u30ED\u30EF\u30FC\u3084\u30EA\u30FC\u30C0\u30FC\u3092\u653B\u6483\u3067\u304D\u306A\u3044\u3002\u300D\u3092\u6301\u3064\u3002"
    - ID: 4406
      Name: "\u3069\u3053\u306B\u3067\u3082\u3044\u308B\u30D5\u30C4\u30FC\u306E\u5973\u306E\u5B50\u30FB\u30E1\u30B0"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u5965\u7FA9\u3011\u3053\u308C\u306F\u8D85\u9032\u5316\u3059\u308B\u3002\n\u81EA\u5206\u306E\u5143\u306E\u30B3\u30B9\u30C82\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u5834\u306B\u51FA\u305F\u3068\u304D\u3001\u3053\u308C\u306F\u3010\u5B88\u8B77\u3011\u3092\u6301\u3064\u3002"
    - ID: 4407
      Name: "\u661F\u6676\u7363\u306E\u5438\u53CE"
      CardText: "\u76F8\u624B\u306E\u5834\u306E\u30AB\u30FC\u30C91\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u3092\u6D88\u6EC5\u3057\u3066\u3001\u540C\u540D\u306E\u30AB\u30FC\u30C91\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002"
    - ID: 4408
      Name: "\u4E16\u754C\u306E\u5473\u65B9\u30FB\u30BE\u30FC\u30A4"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306EPP\u6700\u5927\u5024\u3092+1\u3059\u308B\u3002\n\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_10\u3011\u3053\u308C\u306F\u3010\u75BE\u8D70\u3011\u3092\u6301\u3064\u3002\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u306E\u4F53\u529B\u306E\u6700\u5927\u5024\u30921\u306B\u3059\u308B\u3002\u76F8\u624B\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u307E\u3067\u3001\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u306F\u300C\u53D7\u3051\u308B1\u4EE5\u4E0A\u306E\u30C0\u30E1\u30FC\u30B8\u30920\u306B\u3059\u308B\u3002\u300D\u3092\u6301\u3064\u3002"
    - ID: 4409
      Name: "\u708E\u306E\u7406\u30FB\u30A6\u30A3\u30EB\u30CA\u30B9"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306B8\u30C0\u30E1\u30FC\u30B8\u3002\n\u3010\u5A01\u5727\u3011\n\u3010\u9032\u5316\u6642\u3011\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3068\u540C\u3058\u80FD\u529B\u304C\u50CD\u304F\u3002"
    - ID: 4500
      Name: "\u61A7\u61AC\u306E\u9244\u69CC\u30FB\u30A2\u30EB\u30E1\u30A4\u30C0"
      CardText: "\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_4\u3011\u3053\u308C\u306F\u9032\u5316\u3059\u308B\u3002\u3053\u308C\u306F+1/+1\u3059\u308B\u3002\n\u3010\u7A81\u9032\u3011"
    - ID: 4501
      Name: "\u4E0D\u5C48\u306E\u92ED\u5203\u30FB\u30D0\u30B6\u30E9\u30AC"
      CardText: "\u3010\u5A01\u5727\u3011\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u300E\u4E0D\u5C48\u306E\u92ED\u5203\u30FB\u30D0\u30B6\u30E9\u30AC\u300F1\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u306B2\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 4502
      Name: "\u30F4\u30A1\u30EA\u30A2\u30F3\u30C8\u30A8\u30C3\u30B8"
      CardText: "\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u306B2\u30C0\u30E1\u30FC\u30B8\u3002\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u30F4\u30A1\u30EA\u30A2\u30F3\u30C8\u30A8\u30C3\u30B8\u300F\u3092\u6301\u3064\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_2\u3011\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306B2\u30C0\u30E1\u30FC\u30B8\u3002\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30921\u56DE\u5FA9\u3002"
    - ID: 4503
      Name: "\u611B\u306E\u65C5\u4EBA\u30FB\u30B5\u30C6\u30E5\u30ED\u30B9"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u5834\u306B\u9032\u5316\u5F8C\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u3042\u308B\u306A\u3089\u3001\u3053\u308C\u306F\u9032\u5316\u3059\u308B\u3002\n\u3010\u30AA\u30FC\u30E9\u3011"
    - ID: 4504
      Name: "\u5143\u7D20\u306E\u5171\u9CF4\u30FB\u30D0\u30A2\u30EB"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u30E2\u30FC\u30C9\u30111\u3064\u3092\u9078\u3093\u3067\u305D\u306E\u80FD\u529B\u304C\u50CD\u304F\u3002\n\uFF081\uFF09\u81EA\u5206\u306E\u5834\u306E\u4ED6\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u3068\u3053\u308C\u306F+1/+1\u3059\u308B\u3002\n\uFF082\uFF09\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306B3\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 4505
      Name: "\u8987\u7A7A\u306E\u6B66\u795E\u30FB\u30CA\u30BF\u30AF"
      CardText: "\u3010\u7A81\u9032\u3011\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306B4\u30C0\u30E1\u30FC\u30B8\u3002\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306B2\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 4506
      Name: "\u751F\u6EC5\u306E\u6280\u5DE7\u30FB\u30CD\u30CF\u30F3"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u5834\u306E\u9032\u5316\u524D\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306F\u9032\u5316\u3059\u308B\u3002\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u306B2\u30C0\u30E1\u30FC\u30B8\u3002\n\u3010\u30C9\u30EC\u30A4\u30F3\u3011"
    - ID: 4507
      Name: "\u30B3\u30E9\u30D7\u30B7\u30E7\u30F3"
      CardText: "\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306F-2/-2\u3059\u308B\u3002\u81EA\u5206\u3068\u76F8\u624B\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u30B3\u30E9\u30D7\u30B7\u30E7\u30F3\u300F\u3092\u6301\u3064\u3002\u3010\u89E3\u653E\u5965\u7FA9\u3011\u81EA\u5206\u306E\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u30B3\u30E9\u30D7\u30B7\u30E7\u30F3\u300F\u3092\u7834\u58CA\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_4\u3011\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u306B2\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 4508
      Name: "\u95C7\u306E\u7406\u30FB\u30D5\u30A7\u30C7\u30A3\u30A8\u30EB"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u30CD\u30AF\u30ED\u30DE\u30F3\u30B9_6\u3011\u3010\u30EA\u30A2\u30CB\u30E1\u30A4\u30C8_2\u3011\u3068\u3010\u30EA\u30A2\u30CB\u30E1\u30A4\u30C8_1\u3011\u3092\u884C\u3046\u3002\u305D\u308C\u306F\u9032\u5316\u3059\u308B\u3002\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306F-2/-2\u3059\u308B\u3002"
    - ID: 4509
      Name: "\u72E1\u77E5\u306E\u5815\u5929\u53F8\u30FB\u30D9\u30EA\u30A2\u30EB"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u5834\u306E\u4ED6\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306B10\u30C0\u30E1\u30FC\u30B8\u3002\u3010\u89E3\u653E\u5965\u7FA9\u3011\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u72E1\u77E5\u306E\u5815\u5929\u53F8\u30FB\u30D9\u30EA\u30A2\u30EB\u300F\u3092\u6301\u3064\u3002\n\u3010\u8D85\u9032\u5316\u6642\u3011\u81EA\u5206\u306E\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u72E1\u77E5\u306E\u5815\u5929\u53F8\u30FB\u30D9\u30EA\u30A2\u30EB\u300F\u306E\u30AB\u30A6\u30F3\u30C8\u3092-1\u3059\u308B\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_4\u3011\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u306B20\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 4600
      Name: "\u6E05\u304F\u6B63\u3057\u3044\u4FEE\u9053\u5973\u30FB\u30E9\u30E0\u30EC\u30C3\u30C0"
      CardText: "\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u3053\u308C\u304C\u9032\u5316\u5F8C\u306A\u3089\u3001\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306B2\u30C0\u30E1\u30FC\u30B8\u3002\n\u3010\u9032\u5316\u6642\u3011\u30BF\u30FC\u30F3\u7D42\u4E86\u307E\u3067\u3001\u3053\u308C\u306F\u300C\u30D5\u30A9\u30ED\u30EF\u30FC\u3084\u30EA\u30FC\u30C0\u30FC\u3092\u653B\u6483\u3067\u304D\u306A\u3044\u3002\u300D\u3092\u6301\u3064\u3002"
    - ID: 4601
      Name: "\u82F1\u96C4\u5E7B\u8996\u30FB\u30C8\u30EB\u30FC"
      CardText: "\u3010\u75BE\u8D70\u3011\n\u81EA\u5206\u304C\u30A2\u30DF\u30E5\u30EC\u30C3\u30C8\u3092\u3010\u30A2\u30AF\u30C8\u3011\u3057\u305F\u3068\u304D\u3001\u3053\u308C\u306F\u3010\u30C9\u30EC\u30A4\u30F3\u3011\u3092\u6301\u3064\u3002"
    - ID: 4602
      Name: "\u30EA\u30FC\u30EA\u30A8\u30FB\u30E9\u30A4\u30C4"
      CardText: "\u30B3\u30B9\u30C82\u3010\u30A2\u30AF\u30C8\u3011\u3053\u308C\u3092\u7834\u58CA\u3002\u81EA\u5206\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306F\u300E\u30EA\u30FC\u30EA\u30A8\u30FB\u30E9\u30A4\u30C4\u300F\u306B\u5909\u8EAB\u3059\u308B\u3002\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30891\u679A\u3092\u5F15\u304F\u3002"
    - ID: 4603
      Name: "\u7802\u795E\u306E\u5DEB\u5973\u30FB\u30B5\u30E9"
      CardText: "\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_6\u3011\u3053\u308C\u306F+0/+10\u3059\u308B\u3002\n\u3010\u5B88\u8B77\u3011\n\u3010\u9032\u5316\u6642\u3011\u76F8\u624B\u306E\u5834\u306E\u30C0\u30E1\u30FC\u30B8\u3092\u53D7\u3051\u3066\u3044\u308B\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u3092\u7834\u58CA\u3002"
    - ID: 4604
      Name: "\u30BC\u30A8\u30F3\u6559\u306E\u50E7\u4FB6\u30FB\u30BD\u30D5\u30A3\u30A2"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u306E\u30B3\u30B9\u30C82\u4EE5\u4E0B\u306E\u30D3\u30B7\u30E7\u30C3\u30D7\u30FB\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\n\u3010\u8D85\u9032\u5316\u6642\u3011\u81EA\u5206\u306E\u5834\u306E\u4ED6\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306F\u3010\u30D0\u30EA\u30A2\u3011\u3092\u6301\u3064\u3002"
    - ID: 4605
      Name: "\u7A7A\u3092\u5F81\u304F\u8247"
      CardText: "\u624B\u672D\u3067\u50CD\u304F\u3002\u81EA\u5206\u304C\u30A2\u30DF\u30E5\u30EC\u30C3\u30C8\u3092\u3010\u30A2\u30AF\u30C8\u3011\u3057\u305F\u3068\u304D\u3001\u3053\u308C\u306E\u30B3\u30B9\u30C8\u3092-1\u3059\u308B\u3002\n\u3010\u30A2\u30AF\u30C8\u3011\u3053\u308C\u3092\u7834\u58CA\u3002\u81EA\u5206\u306E\u5834\u306E\u9032\u5316\u524D\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306F\u9032\u5316\u3059\u308B\u3002"
    - ID: 4606
      Name: "\u9B54\u6756\u306E\u5916\u79D1\u533B\u30FB\u30C6\u30A3\u30B3"
      CardText: "\u81EA\u5206\u304C\u30A2\u30DF\u30E5\u30EC\u30C3\u30C8\u3092\u3010\u30A2\u30AF\u30C8\u3011\u3057\u305F\u3068\u304D\u3001\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30921\u56DE\u5FA9\u3002\n\u3010\u9032\u5316\u6642\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306B3\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 4607
      Name: "\u30EC\u30FB\u30D5\u30A3\u30FC\u30A8\u306E\u5B9D\u77F3"
      CardText: "\u3010\u30A2\u30AF\u30C8\u3011\u3053\u308C\u3092\u7834\u58CA\u3002\u3010\u30E2\u30FC\u30C9\u30111\u3064\u3092\u9078\u3093\u3067\u305D\u306E\u80FD\u529B\u304C\u50CD\u304F\u3002\n\uFF081\uFF09\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u3092\u7834\u58CA\u3002\n\uFF082\uFF09\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30892\u679A\u3092\u5F15\u304F\u3002"
    - ID: 4608
      Name: "\u571F\u306E\u7406\u30FB\u30AC\u30EC\u30F2\u30F3"
      CardText: "\u3010\u5B88\u8B77\u3011\n\u30D5\u30A9\u30ED\u30EF\u30FC\u3084\u30EA\u30FC\u30C0\u30FC\u3092\u653B\u6483\u3067\u304D\u306A\u3044\u3002\n\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u3001\u8D85\u9032\u5316\u53EF\u80FD\u30BF\u30FC\u30F3\u306A\u3089\u3001\u81EA\u5206\u306E\u5834\u306E\u300C\u3053\u306E\u30BF\u30FC\u30F3\u4E2D\u306B\u653B\u6483\u3057\u3066\u3044\u306A\u3044\u3001\u9032\u5316\u524D\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u300D\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306F\u9032\u5316\u3059\u308B\u3002"
    - ID: 4609
      Name: "\u5A01\u5BB9\u306A\u308B\u661F\u6676\u9A0E\u58EB\u30FB\u30F4\u30A3\u30FC\u30E9"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC2\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u3092\u6D88\u6EC5\u3002\u3010\u89E3\u653E\u5965\u7FA9\u3011\u3053\u308C\u306F\u8D85\u9032\u5316\u3059\u308B\u3002\n\u3010\u5B88\u8B77\u3011\n\u53D7\u3051\u308B4\u4EE5\u4E0A\u306E\u30C0\u30E1\u30FC\u30B8\u30923\u306B\u3059\u308B\u3002"
    - ID: 4700
      Name: "\u7206\u71C3\u306E\u7DCF\u9577\u30FB\u30C4\u30D0\u30B5"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u624B\u672D\u3059\u3079\u3066\u306E\u5965\u7FA9\u30B2\u30FC\u30B8\u3092+1\u3059\u308B\u3002\n\u3010\u7A81\u9032\u3011"
    - ID: 4701
      Name: "\u5831\u6069\u306E\u6280\u5E2B\u30FB\u30A2\u30A4\u30B6\u30C3\u30AF"
      CardText: "\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u300E\u30A2\u30BF\u30C3\u30AF\u30A2\u30FC\u30C6\u30A3\u30D5\u30A1\u30AF\u30C8\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002"
    - ID: 4702
      Name: "\u518D\u8D77\u306E\u591C\u738B\u30FB\u30B7\u30E7\u30A6"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u8D85\u9032\u5316\u53EF\u80FD\u30BF\u30FC\u30F3\u306A\u3089\u3001\u3053\u308C\u306F\u3010\u30D0\u30EA\u30A2\u3011\u3092\u6301\u3064\u3002\n\u3010\u75BE\u8D70\u3011"
    - ID: 4703
      Name: "\u8F5F\u96F7\u306E\u9583\u72FC\u30FB\u30E6\u30FC\u30B9\u30C6\u30B9"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u5965\u7FA9\u3011\u81EA\u5206\u306E\u5834\u306E\u4ED6\u306E\u9032\u5316\u524D\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u3068\u3053\u308C\u306F\u9032\u5316\u3059\u308B\u3002\n\u3010\u4EA4\u6226\u6642\u3011\u4EA4\u6226\u76F8\u624B\u306B3\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 4704
      Name: "\u53B3\u70C8\u306A\u308B\u6559\u5B98\u30FB\u30A4\u30EB\u30B6"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u3010\u30E2\u30FC\u30C9\u30111\u3064\u3092\u9078\u3093\u3067\u305D\u306E\u80FD\u529B\u304C\u50CD\u304F\u3002\n\uFF081\uFF09\u300C\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306B4\u30C0\u30E1\u30FC\u30B8\u3002\u300D\u30923\u56DE\u884C\u3046\u3002\n\uFF082\uFF09\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u306B4\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 4705
      Name: "\u30B9\u30C8\u30FC\u30F3\u30FB\u30D6\u30EC\u30A4\u30AF"
      CardText: "\u300C\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u304B\u3089\u30E9\u30F3\u30C0\u30E01\u679A\u306B1\u30C0\u30E1\u30FC\u30B8\u3002\u300D\u30926\u56DE\u884C\u3046\u3002"
    - ID: 4706
      Name: "\u7A7A\u6155\u3046\u5E30\u9084\u8005\u30FB\u30AB\u30B7\u30A6\u30B9"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u624B\u672D\u306E\u30A2\u30FC\u30C6\u30A3\u30D5\u30A1\u30AF\u30C8\u30FB\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306BX\u30C0\u30E1\u30FC\u30B8\u3002X\u306F\u9078\u3093\u3060\u30D5\u30A9\u30ED\u30EF\u30FC\u306E\u653B\u6483\u529B\u3067\u3042\u308B\u3002\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u300E\u30AD\u30E3\u30C3\u30B9\u30EB\u30A2\u30FC\u30C6\u30A3\u30D5\u30A1\u30AF\u30C8\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002"
