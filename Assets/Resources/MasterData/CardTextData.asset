      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30923\u56DE\u5FA9\u3002\n\u3010\u5B88\u8B77\u3011\n\u3010\u9032\u5316\u6642\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306B3\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 1617
