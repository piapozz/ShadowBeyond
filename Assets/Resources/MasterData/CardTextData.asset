      CardText: "\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_4\u3011\u81EA\u5206\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u304B\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u3092\u9078\u3076\u3002\u305D\u308C\u30923\u56DE\u5FA9\u3002"
