      CardText: "\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_3\u3011\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30892\u679A\u3092\u5F15\u304F\u3002\n\u30B3\u30B9\u30C81\u3010\u30A2\u30AF\u30C8\u3011\u3053\u308C\u306E\u30AB\u30A6\u30F3\u30C8\u3092-1\u3059\u308B\u3002"
    - ID: 1606
      Name: "\u714C\u69CD\u306E\u30A2\u30EB\u30DF\u30E9\u30FC\u30B8\u30FB\u30B5\u30EA\u30C3\u30B5"
      CardText: "\u81EA\u5206\u306E\u3010\u5B88\u8B77\u3011\u3092\u6301\u3064\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u7834\u58CA\u3055\u308C\u305F\u3068\u304D\u3001\u3053\u308C\u306F+1/+1\u3059\u308B\u3002\n\u3010\u9032\u5316\u6642\u3011\u3053\u308C\u306F\u3010\u30D0\u30EA\u30A2\u3011\u3092\u6301\u3064\u3002"
    - ID: 1607
      Name: "\u714C\u7FFC\u306E\u30D5\u30A7\u30B6\u30FC\u30D5\u30A9\u30EB\u30AF\u30FB\u30EA\u30CE"
      CardText: "\u3010\u4EA4\u6226\u6642\u3011\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u306B1\u30C0\u30E1\u30FC\u30B8\u3002\n\u3010\u8D85\u9032\u5316\u6642\u3011\u3053\u308C\u306F\u300C1\u30BF\u30FC\u30F3\u306B2\u56DE\u653B\u6483\u3067\u304D\u308B\u3002\u300D\u3092\u6301\u3064\u3002"
    - ID: 1608
