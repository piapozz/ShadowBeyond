      CardText: "\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_6\u3011\u3053\u308C\u306F\u300C\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u300E\u30CA\u30A4\u30C8\u300F2\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\u300D\u3092\u6301\u3064\u3002\n\u3010\u7A81\u9032\u3011"
