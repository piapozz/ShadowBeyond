      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u304B\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u3092\u9078\u3076\u3002\u305D\u308C\u306B3\u30C0\u30E1\u30FC\u30B8\u3002\u3010\u571F\u306E\u79D8\u8853_1\u3011\u9078\u3076\u306E\u3067\u306F\u306A\u304F\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u3068\u76F8\u624B\u306E\u30EA\u30FC\u30C0\u30FC\u3002"
    - ID: 105310
      Name: "\u30B4\u30FC\u30EC\u30E0\u30A2\u30B5\u30EB\u30C8"
      CardText: "\u300E\u30AC\u30FC\u30C7\u30A3\u30A2\u30F3\u306E\u932C\u6210\u300F1\u679A\u3092\u81EA\u5206\u306E\u624B\u672D\u306B\u52A0\u3048\u308B\u3002\u3010\u571F\u306E\u79D8\u8853_1\u3011\u81EA\u5206\u306E\u624B\u672D\u306E\u300E\u30AC\u30FC\u30C7\u30A3\u30A2\u30F3\u306E\u7DF4\u6210\u300F\u3059\u3079\u3066\u306E\u30B3\u30B9\u30C8\u3092-1\u3059\u308B\u3002\n\u3010\u30A8\u30F3\u30CF\u30F3\u30B9_7\u30111\u679A\u3067\u306F\u306A\u304F3\u679A\u3002"
    - ID: 105311
      Name: "\u547C\u3073\u899A\u307E\u3055\u308C\u3057\u7981\u5FCC"
      CardText: "\u3053\u308C\u304C\u9032\u5316\u524D\u306A\u3089\u3001\u30D5\u30A9\u30ED\u30EF\u30FC\u3084\u30EA\u30FC\u30C0\u30FC\u3092\u653B\u6483\u3067\u304D\u306A\u3044\u3002\n\u81EA\u5206\u306E\u624B\u672D\u306B\u30AB\u30FC\u30C9\u304C\u52A0\u308F\u3063\u305F\u3068\u304D\u3001\u81EA\u5206\u306E\u30BF\u30FC\u30F3\u4E2D\u3067\u624B\u672D\u304C9\u679A\u306A\u3089\u3001\u3053\u308C\u306F\u9032\u5316\u3059\u308B\u3002\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC\u3059\u3079\u3066\u306B3\u30C0\u30E1\u30FC\u30B8\u3002"
    - ID: 105312
      Name: "\u30AA\u30BA\u306E\u5927\u9B54\u5973"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u3089X\u679A\u3092\u5F15\u304F\u3002X\u306F5\u304B\u3089\u81EA\u5206\u306E\u624B\u672D\u306E\u679A\u6570\u3092\u5F15\u3044\u305F\u6570\u3067\u3042\u308B\u3002\u81EA\u5206\u306E\u624B\u672D\u306E\u3010\u30B9\u30DA\u30EB\u30D6\u30FC\u30B9\u30C8\u6642\u3011\u3092\u6301\u305F\u306A\u3044\u30B9\u30DA\u30EB\u3059\u3079\u3066\u306E\u30B3\u30B9\u30C8\u30921\u306B\u3059\u308B\u3002\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u30AA\u30BA\u306E\u5927\u9B54\u5973\u300F\u3092\u6301\u3064\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u3010\u30AB\u30A6\u30F3\u30C8\u30C0\u30A6\u30F3_1\u3011\n\u3010\u30E9\u30B9\u30C8\u30EF\u30FC\u30C9\u3011\u81EA\u5206\u306E\u624B\u672D\u306E\u30B9\u30DA\u30EB\u3059\u3079\u3066\u3092\u6D88\u6EC5\u3002"
