      CardText: "\u3010\u30A2\u30AF\u30C8\u3011\u3053\u308C\u3092\u7834\u58CA\u3002\u76F8\u624B\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306B4\u30C0\u30E1\u30FC\u30B8\u3002\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30921\u56DE\u5FA9\u3002"
    - ID: 1611
