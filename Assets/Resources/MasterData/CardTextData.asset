    - ID: 2406
      Name: "\u84BC\u6D77\u306E\u88C1\u304D\u30FB\u30CD\u30D7\u30C1\u30E5\u30FC\u30F3"
      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306F\u300E\u30AF\u30EC\u30B9\u30C8\uFF1A\u84BC\u6D77\u306E\u88C1\u304D\u30FB\u30CD\u30D7\u30C1\u30E5\u30FC\u30F3\u300F\u3092\u6301\u3064\u3002\u300E\u5927\u6D77\u306E\u30AA\u30EB\u30AB\u300F2\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\n\u3010\u5B88\u8B77\u3011\n\u3010\u8D85\u9032\u5316\u6642\u3011\u300E\u5927\u6D77\u306E\u30AA\u30EB\u30AB\u300F2\u679A\u3092\u81EA\u5206\u306E\u5834\u306B\u51FA\u3059\u3002\n\u30AF\u30EC\u30B9\u30C8\n\u81EA\u5206\u306E\u6D77\u6D0B\u30FB\u30D5\u30A9\u30ED\u30EF\u30FC\u304C\u5834\u306B\u51FA\u305F\u3068\u304D\u3001\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30921\u56DE\u5FA9\u3002"
