      CardText: "\u30B3\u30B9\u30C81\u3010\u30A2\u30AF\u30C8\u3011\u81EA\u5206\u306E\u5834\u306E\u30D5\u30A9\u30ED\u30EF\u30FC1\u679A\u3092\u9078\u3076\u3002\u305D\u308C\u306F+1/+1\u3059\u308B\u3002\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30921\u56DE\u5FA9\u3002"
