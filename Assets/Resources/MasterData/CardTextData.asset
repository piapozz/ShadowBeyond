      CardText: "\u3010\u30D5\u30A1\u30F3\u30D5\u30A1\u30FC\u30EC\u3011\u81EA\u5206\u306E\u30C7\u30C3\u30AD\u304B\u30892\u679A\u3092\u5F15\u304F\u3002\u81EA\u5206\u306E\u30EA\u30FC\u30C0\u30FC\u30922\u56DE\u5FA9\u3002"
